-- Rolls & Dice: Dice Manager
do
    local Dice = require(ReplicatedStorage:WaitForChild("Framework"):WaitForChild("Features"):WaitForChild("Rolling"):WaitForChild("Dice"))
    local shopService = newComm("DiceShopService")
    local buySignal = shopService:GetSignal("BuyDice")
    local equipSignal = shopService:GetSignal("EquipDice")
    local allDice = Dice.GetAll()

    local buyActive = false
    local buyLoop = nil
    local equipActive = false
    local equipLoop = nil

    local function buyAllAffordable()
        local money = DataController.Money()
        local bought = false
        for diceId, diceData in pairs(allDice) do
            if diceData.price and not DataController.OwnedDice[diceId]() and money >= diceData.price then
                pcall(function() buySignal:Fire(diceId) end)
                bought = true
                task.wait(0.2)
            end
        end
        return bought
    end

    local function equipBest()
        local bestId = nil
        local bestLuck = -1
        for diceId, diceData in pairs(allDice) do
            if DataController.OwnedDice[diceId]() and diceData.luck and diceData.luck > bestLuck then
                bestLuck = diceData.luck
                bestId = diceId
            end
        end
        if bestId and bestId ~= DataController.Dice() then
            pcall(function() equipSignal:Fire(bestId) end)
            return true
        end
        return false
    end

    local function startBuy()
        buyActive = true
        buyLoop = task.spawn(function()
            while buyActive do
                local bought = buyAllAffordable()
                task.wait(bought and 0.5 or 2)
            end
        end)
    end

    local function stopBuy()
        buyActive = false
        if buyLoop then task.cancel(buyLoop) buyLoop = nil end
    end

    local function startEquip()
        equipActive = true
        equipLoop = task.spawn(function()
            while equipActive do
                equipBest()
                task.wait(1)
            end
        end)
    end

    local function stopEquip()
        equipActive = false
        if equipLoop then task.cancel(equipLoop) equipLoop = nil end
    end

    RollsTab:Toggle({
        Title = "Auto Buy Dice",
        Desc = "Automatically buys all dice you can afford that you do not already own.",
        Value = false,
        Callback = function(state) if state then startBuy() else stopBuy() end end
    })

    RollsTab:Toggle({
        Title = "Auto Equip Best Dice",
        Desc = "Automatically equips your best owned dice every second.",
        Value = false,
        Callback = function(state) if state then startEquip() else stopEquip() end end
    })
end

-- Progression: Auto Buy Upgrades
do
    local Upgrades = require(ReplicatedStorage:WaitForChild("Framework"):WaitForChild("Features"):WaitForChild("Upgrades"):WaitForChild("Upgrades"))
    local TreeStructure = require(ReplicatedStorage:WaitForChild("Framework"):WaitForChild("Features"):WaitForChild("Upgrades"):WaitForChild("TreeStructure"))
    local BuyUpgrade = Network.Client.GetSignal(ReplicatedStorage:WaitForChild("Network"), "BuyUpgrade")
    local upgradeNames = {}
    for name, _ in pairs(Upgrades) do if name ~= "Start" then table.insert(upgradeNames, name) end end

    local autoActive = false
    local loopThread = nil

    local function isOwned(name)
        return DataController.Upgrades[name] and DataController.Upgrades[name]()
    end

    local function canBuy(name)
        if isOwned(name) then return false end
        local parent = TreeStructure.GetParent(name)
        if parent and parent ~= "Start" and not isOwned(parent) then return false end
        return DataController.Money() >= Upgrades[name].price
    end

    local function buyAll()
        local bought = false
        for _, name in ipairs(upgradeNames) do
            if canBuy(name) then
                pcall(function() BuyUpgrade:Fire(name) end)
                bought = true
                task.wait(0.2)
            end
        end
        return bought
    end

    local function start()
        autoActive = true
        loopThread = task.spawn(function()
            while autoActive do
                local bought = buyAll()
                task.wait(bought and 0.5 or 2)
            end
        end)
    end

    local function stop()
        autoActive = false
        if loopThread then task.cancel(loopThread) loopThread = nil end
    end

    ProgressionTab:Toggle({
        Title = "Auto Buy Upgrades",
        Desc = "Automatically buys all upgrades you can afford in the correct order.",
        Value = false,
        Callback = function(state) if state then start() else stop() end end
    })
end

