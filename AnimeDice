-- Grades & Traits: Trait
do
    local Traits = require(ReplicatedStorage:WaitForChild("Framework"):WaitForChild("Features"):WaitForChild("Traits"):WaitForChild("Traits"))
    local EntryRegistry = require(ReplicatedStorage:WaitForChild("Framework"):WaitForChild("Features"):WaitForChild("Inventory"):WaitForChild("EntryRegistry"))
    local traitService = newComm("TraitService")
    local rollSignal = traitService:GetSignal("Roll")

    local unitLabelToKey = {}
    local unitLabels = {}

    local function getRarityLabel(config, attributes)
        if config.rarity and type(config.rarity) == "string" then return config.rarity end
        if config.getRarity then return config.getRarity(attributes) end
        return "Unknown"
    end

    local function getInventoryEntry(key)
        local inv = DataController.Inventory()
        local state = inv and inv[key]
        if not state then return nil end
        if type(state) == "function" then return state() else return state end
    end

    local function refreshUnits()
        unitLabelToKey = {}
        unitLabels = {}
        local inv = DataController.Inventory()
        if not inv then return unitLabels end
        for key, _ in pairs(inv) do
            local entry = getInventoryEntry(key)
            if entry then
                local config = EntryRegistry.getEntryConfig(entry.name)
                if config and config.kind == "Unit" then
                    local rarity = getRarityLabel(config, entry.attributes)
                    local label = entry.name .. " (" .. rarity .. ")"
                    unitLabelToKey[label] = key
                    table.insert(unitLabels, label)
                end
            end
        end
        table.sort(unitLabels)
        return unitLabels
    end

    local traitNames = {}
    for name in pairs(Traits) do table.insert(traitNames, name) end
    table.sort(traitNames)

    local selectedUnitKey = nil
    local selectedUnitLabel = nil
    local selectedTrait = traitNames[1]

    local unitDropdown = GradesTraitsTab:Dropdown({
        Title = "Select Unit",
        Desc = "Choose which unit to roll traits for.",
        Values = refreshUnits(),
        Value = nil,
        Multi = false,
        Callback = function(choice)
            selectedUnitLabel = choice
            selectedUnitKey = unitLabelToKey[choice]
        end
    })

    local initialUnits = refreshUnits()
    if #initialUnits > 0 then
        unitDropdown:Refresh(initialUnits)
        unitDropdown:Select(initialUnits[1])
        selectedUnitLabel = initialUnits[1]
        selectedUnitKey = unitLabelToKey[selectedUnitLabel]
    end

    local traitDropdown = GradesTraitsTab:Dropdown({
        Title = "Target Trait",
        Desc = "Choose the trait you want to obtain.",
        Values = traitNames,
        Value = selectedTrait,
        Multi = false,
        Callback = function(choice) selectedTrait = choice end
    })

    GradesTraitsTab:Button({
        Title = "Refresh Units",
        Desc = "Refreshes the list of units in your inventory.",
        Callback = function()
            local newList = refreshUnits()
            unitDropdown:Refresh(newList)
            if #newList > 0 then
                if not selectedUnitLabel or not unitLabelToKey[selectedUnitLabel] then
                    selectedUnitLabel = newList[1]
                    selectedUnitKey = unitLabelToKey[selectedUnitLabel]
                    unitDropdown:Select(newList[1])
                end
            else
                selectedUnitKey = nil
                selectedUnitLabel = nil
            end
        end
    })

    GradesTraitsTab:Button({
        Title = "Roll Once",
        Desc = "Rolls for a new trait once.",
        Callback = function()
            if selectedUnitKey then
                pcall(function() rollSignal:Fire(selectedUnitKey, true) end)
            else
                WindUI:Notify({ Title = "Auto Trait", Content = "No unit selected.", Duration = 3, Icon = "x" })
            end
        end
    })

    local autoActive = false
    local traitLoop = nil

    local function getUnitTrait(key)
        local entry = getInventoryEntry(key)
        if entry and entry.attributes and entry.attributes.trait then
            local trait = entry.attributes.trait
            if type(trait) == "function" then return trait() else return trait end
        end
        return nil
    end

    local function start()
        autoActive = true
        traitLoop = task.spawn(function()
            while autoActive do
                if selectedUnitKey then
                    local currentTrait = getUnitTrait(selectedUnitKey)
                    if currentTrait == selectedTrait then
                        autoActive = false
                        traitToggle:Set(false)
                        WindUI:Notify({ Title = "Auto Trait", Content = "Target trait reached: " .. currentTrait, Duration = 3, Icon = "check" })
                        break
                    end
                    pcall(function() rollSignal:Fire(selectedUnitKey, true) end)
                end
                task.wait(0.5)
            end
        end)
    end

    local function stop()
        autoActive = false
        if traitLoop then task.cancel(traitLoop) traitLoop = nil end
    end

    local traitToggle = GradesTraitsTab:Toggle({
        Title = "Start Auto Trait",
        Desc = "Automatically rolls traits until the selected trait is obtained.",
        Value = false,
        Callback = function(state) if state then start() else stop() end end
    })
end

