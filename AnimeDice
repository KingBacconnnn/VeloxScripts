    local rollSignal = traitService:GetSignal("Roll")

    local unitLabelToKey = {}
    local unitLabels = {}

    local function getRarityLabel(config, attributes)
        if config.rarity and type(config.rarity) == "string" then return config.rarity end
        if config.getRarity then return config.getRarity(attributes) end
        return "Unknown"
    end

    local function getInventoryEntry(key)
        local inv = _G.DataController.Inventory()
        local state = inv and inv[key]
        if not state then return nil end
        if type(state) == "function" then return state() else return state end
    end

    local function refreshUnits()
        unitLabelToKey = {}
        unitLabels = {}
        local inv = _G.DataController.Inventory()
        if not inv then return unitLabels end
        for key, _ in pairs(inv) do
            local entry = getInventoryEntry(key)
            if entry then
                local config = EntryRegistry.getEntryConfig(entry.name)
                if config and config.kind == "Unit" then
                    local rarity = getRarityLabel(config, entry.attributes)
                    local label = entry.name .. " (" .. rarity .. ")"
                    unitLabelToKey[label] = key
                    table.insert(unitLabels, label)
                end
            end
        end
        table.sort(unitLabels)
        return unitLabels
    end

    local traitNames = {}
    for name in pairs(Traits) do table.insert(traitNames, name) end
    table.sort(traitNames)

