-- Auto Collect Money
do
    local plotService = newComm("PlotService")
    local collectSignal = plotService:GetSignal("CollectBalance")
    local PlotConfig = require(ReplicatedStorage:WaitForChild("Framework"):WaitForChild("Features"):WaitForChild("Plot"):WaitForChild("PlotConfig"))
    local maxSlots = PlotConfig.GetMaxSlots()

    local autoActive = false
    local collectLoop = nil

    local function getSlotState(slotIndex)
        local state = DataController.Slots[tostring(slotIndex)]
        if state then
            return state()
        end
        return nil
    end

    local function collectAll()
        local collectedAny = false
        for slot = 1, maxSlots do
            local data = getSlotState(slot)
            if data and data.balance and data.balance > 0 then
                pcall(function()
                    collectSignal:Fire(slot)
                end)
                collectedAny = true
                task.wait(0.1)
            end
        end
        return collectedAny
    end

    local function startAuto()
        autoActive = true
        collectLoop = task.spawn(function()
            while autoActive do
                collectAll()
                task.wait(1)
            end
        end)
    end

    local function stopAuto()
        autoActive = false
        if collectLoop then task.cancel(collectLoop) collectLoop = nil end
    end

    PlotTab:Toggle({
        Title = "Auto Collect Money",
        Desc = "Collects all slot balances every second.",
        Value = false,
        Callback = function(state)
            if state then startAuto() else stopAuto() end
        end
    })

    PlotTab:Button({
        Title = "Collect Once",
        Desc = "Collects all current slot balances manually.",
        Callback = function()
            collectAll()
        end
    })
end

