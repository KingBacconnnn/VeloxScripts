-- Selling
do
    local NumberFormatter = require(ReplicatedStorage:WaitForChild("Packages"):WaitForChild("NumberFormatter"))
    local sellService = newComm("SellService")
    local sellInventory = sellService:GetFunction("SellInventory")
    local updateAutoSell = sellService:GetSignal("UpdateAutoSell")

    local sellAllActive = false
    local sellAllLoop = nil

    local function sellAllNow()
        local keys = {}
        for key in pairs(DataController.Inventory()) do
            table.insert(keys, key)
        end
        if #keys > 0 then
            pcall(function() sellInventory(keys) end)
        end
    end

    local function startSellAll()
        sellAllActive = true
        sellAllLoop = task.spawn(function()
            while sellAllActive do
                sellAllNow()
                task.wait(1)
            end
        end)
    end

    local function stopSellAll()
        sellAllActive = false
        if sellAllLoop then task.cancel(sellAllLoop) sellAllLoop = nil end
    end

    SellingTab:Toggle({
        Title = "Auto Sell All Inventory",
        Desc = "Automatically sells all units in your inventory every second.",
        Value = false,
        Callback = function(state) if state then startSellAll() else stopSellAll() end end
    })

    local currentThreshold = 0
    local autoSellEnabled = false

    local function parseNumber(text)
        if type(text) ~= "string" then return nil end
        text = text:gsub(",", "")
        local num = tonumber(text)
        if not num then num = NumberFormatter.ParseCompact(text) end
        return num
    end

    local thresholdInput = SellingTab:Input({
        Title = "Auto Sell Threshold",
        Desc = "Sets the value below which units will be automatically sold. Set to 0 to disable.",
        Placeholder = "e.g., 1000000 or 1M",
        Callback = function(text)
            local num = parseNumber(text)
            if num then
                currentThreshold = num
                if autoSellEnabled then
                    pcall(function() updateAutoSell:Fire(num) end)
                end
            end
        end
    })

    local autoSellToggle = SellingTab:Toggle({
        Title = "Enable Auto Sell",
        Desc = "Automatically sells units below the selected threshold.",
        Value = false,
        Callback = function(state)
            autoSellEnabled = state
            pcall(function() updateAutoSell:Fire(state and currentThreshold or 0) end)
        end
    })

    task.spawn(function()
        local current = DataController.AutoSell and DataController.AutoSell() or 0
        if current > 0 then
            currentThreshold = current
            thresholdInput:Set(tostring(current))
            autoSellToggle:Set(true)
            autoSellEnabled = true
        end
    end)
end

-- Daily Reward
do
    local DailyRewardConfig = require(ReplicatedStorage:WaitForChild("Framework"):WaitForChild("Features"):WaitForChild("Rewards"):WaitForChild("DailyRewardConfig"))
    local dailyService = newComm("DailyRewardService")
    local claimSignal = dailyService:GetSignal("Claim")

    local autoActive = false
    local loopThread = nil

    local function isReady()
        local last = DataController.LastDailyRewardClaim()
        if last == 0 then return true end
        return (os.time() - last) >= DailyRewardConfig.Cooldown
    end

    local function start()
        autoActive = true
        loopThread = task.spawn(function()
            while autoActive do
                if isReady() then
                    pcall(function() claimSignal:Fire() end)
                    task.wait(1)
                end
                task.wait(5)
            end
        end)
    end

    local function stop()
        autoActive = false
        if loopThread then task.cancel(loopThread) loopThread = nil end
    end

    DailyTab:Toggle({
        Title = "Auto Claim Daily Reward",
        Desc = "Automatically claims your daily reward when it becomes available.",
        Value = false,
        Callback = function(state) if state then start() else stop() end end
    })
end

-- Auto Use Potion
do
    local BoostController = require(ReplicatedStorage:WaitForChild("Framework"):WaitForChild("Features"):WaitForChild("Inventory"):WaitForChild("Kinds"):WaitForChild("Boost"):WaitForChild("BoostController"))

    local POTION_OPTIONS = {
        "Luck I", "Luck II", "Luck III", "Luck IV",
        "Damage I", "Damage II", "Damage III", "Damage IV",
        "Income I", "Income II", "Income III", "Income IV",
        "Dragon Luck I", "Dragon Luck II", "Dragon Luck III",
        "Dragon Income I", "Dragon Income II", "Dragon Income III",
        "Dragon Damage I", "Dragon Damage II", "Dragon Damage III",
        "Cursed Luck I", "Cursed Luck II", "Cursed Luck III",
        "Cursed Damage I", "Cursed Damage II", "Cursed Damage III",
        "Cursed Income I", "Cursed Income II", "Cursed Income III",
        "Pirate Luck I", "Pirate Luck II", "Pirate Luck III",
        "Pirate Damage I", "Pirate Damage II", "Pirate Damage III",
        "Pirate Income I", "Pirate Income II", "Pirate Income III",
        "Leaf Luck I", "Leaf Luck II", "Leaf Luck III",
        "Leaf Damage I", "Leaf Damage II", "Leaf Damage III",
        "Leaf Income I", "Leaf Income II", "Leaf Income III",
    }

    local UseInterval = 1.5
    local PostUseWait = 0.6
    local selected = {}
    local autoActive = false
    local loopThread = nil

    local function hasSelection()
        for _ in pairs(selected) do return true end
        return false
    end

    local function matchesSelection(name)
        if not hasSelection() then return true end
        return selected[name] == true
    end

    local function collectInventoryEntries()
        local entries = {}
        local inv = DataController.Inventory
        if not inv then return entries end
        local raw
        pcall(function() raw = inv() end)
        if type(raw) == "table" then
            pcall(function()
                for k, v in pairs(raw) do
                    table.insert(entries, { SlotId = k, Value = v })
                end
            end)
            if #entries > 0 then return entries end
            entries = {}
            pcall(function()
                for k in raw do
                    table.insert(entries, { SlotId = k })
                end
            end)
            if #entries > 0 then return entries end
        end
        entries = {}
        pcall(function()
            for k, v in pairs(inv) do
                table.insert(entries, { SlotId = k, Value = v })
            end
        end)
        if #entries > 0 then return entries end
        entries = {}
        pcall(function()
            for k in inv() do
                table.insert(entries, { SlotId = k })
            end
        end)
        return entries
    end

    local function resolveItemName(entry)
        if not entry then return nil end
        if type(entry.Value) == "table" and type(entry.Value.name) == "string" then
            return entry.Value.name
        end
        if type(entry.Value) == "string" then return entry.Value end
        local inv = DataController.Inventory
        local o, getter = pcall(function() return inv[entry.SlotId] end)
        if o and type(getter) == "function" then
            local o2, item = pcall(getter)
            if o2 and type(item) == "table" and type(item.name) == "string" then
                return item.name
            end
        elseif o and type(getter) == "table" and type(getter.name) == "string" then
            return getter.name
        end
        return nil
    end

    local function scanPotionSlots()
        local list = {}
        local entries = collectInventoryEntries()
        for _, entry in ipairs(entries) do
            local name = resolveItemName(entry)
            if type(name) == "string" and matchesSelection(name) then
                table.insert(list, { SlotId = entry.SlotId, Name = name })
            end
        end
        return list
    end

    local function useBoost(slotId)
        if not BoostController or type(BoostController.UseBoost) ~= "function" then
            return false
        end
        return pcall(function() BoostController.UseBoost(slotId) end)
    end

    local function useLoop()
        while autoActive do
            local potions = scanPotionSlots()
            if #potions == 0 then
                task.wait(UseInterval)
            else
                for _, entry in ipairs(potions) do
                    if not autoActive then break end
                    useBoost(entry.SlotId)
                    task.wait(PostUseWait)
                end
                task.wait(UseInterval)
            end
        end
    end

    local function start()
        autoActive = true
        loopThread = task.spawn(function()
            local ok, err = pcall(useLoop)
            if not ok then warn("[Auto Use Potion] " .. tostring(err)) end
            loopThread = nil
        end)
    end

    local function stop()
        autoActive = false
        if loopThread then task.cancel(loopThread) loopThread = nil end
    end

    PotionsTab:Dropdown({
        Title = "Potion Filter",
        Desc = "Choose which potions to use. Leave empty to use all potions.",
        Values = POTION_OPTIONS,
        Value = {},
        Multi = true,
        AllowNone = true,
        Callback = function(choices)
            selected = {}
            if type(choices) == "table" then
                for _, choice in ipairs(choices) do
                    if type(choice) == "string" then
                        selected[choice] = true
                    end
                end
            elseif type(choices) == "string" then
                selected[choices] = true
            end
        end,
    })

    PotionsTab:Toggle({
        Title = "Auto Use Potion",
        Desc = "Automatically uses the potions that match your filter.",
        Value = false,
        Callback = function(state) if state then start() else stop() end end
    })
end
