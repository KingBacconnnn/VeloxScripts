local rawRequire = (getrenv and getrenv().require) or require
local function safeRequire(module)
    local oldIdentity = (getthreadidentity and getthreadidentity()) or (syn and syn.get_thread_identity and syn.get_thread_identity())
    if setthreadidentity then setthreadidentity(2) elseif setidentity then setidentity(2) end
    local success, result = pcall(rawRequire, module)
    if oldIdentity then
        if setthreadidentity then setthreadidentity(oldIdentity) elseif setidentity then setidentity(oldIdentity) end
    end
    if not success then
        return nil
    end
    return result
end

