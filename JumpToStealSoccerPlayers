local function getHRP()
    local character = LocalPlayer.Character
    if not character then return nil end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then hrp = character:WaitForChild("HumanoidRootPart", 2) end
    return hrp
end

local function getCash()
    local d = Data:Get()
    return d and d.Cash or 0
end

local function getJump()
    return Shared.getPlayerJump() or 0
end

local function getJumpPrice(index, jump)
    local data = SpeedUpgrades[index]
    if not data then return math.huge end
    local base = Shared.getSpeedUpgradePrice(jump, data.PriceMulti) or math.huge
    local amount = data.UpgradeAmount or 1
    return math.round(base * amount)
end

local function isGearOwned(gearId)
    local data = Data:Get()
    if data and data.Gears then
        return table.find(data.Gears, gearId) ~= nil
    end
    return false
end

local function isInventoryFull()
    local data = Data:Get()
    local limit = Settings.InventoryLimits and Settings.InventoryLimits.Gears
    if not limit then return false end
    local owned = data and data.Gears and #data.Gears or 0
    return owned >= limit
end

local function getPosition(instance)
    if instance:IsA("Model") then return instance:GetPivot().Position
    elseif instance:IsA("BasePart") then return instance.Position
    else return instance:GetPivot().Position end
end

local function findPrompt(model)
    for _, child in ipairs(model:GetDescendants()) do
        if child.Name == "StealPrompt" and child:IsA("ProximityPrompt") then
            return child
        end
    end
    return nil
end

local function getUnownedSlimes()
    local live = workspace:FindFirstChild("Live")
    if not live then return {} end
    local slimesFolder = live:FindFirstChild("Slimes")
    if not slimesFolder then return {} end

    local list = {}
    for _, slime in ipairs(slimesFolder:GetChildren()) do
        if slime:IsA("Model") then
            local heldBy = tonumber(slime:GetAttribute("heldBy"))
            if heldBy ~= LocalPlayer.UserId then
                if selectedBlockNames[slime.Name] then
                    local prompt = findPrompt(slime)
                    if prompt and prompt.Enabled then
                        table.insert(list, slime)
                    end
                end
            end
        end
    end
    return list
end

local function getTopTarget()
    local slimes = getUnownedSlimes()
    if #slimes == 0 then return nil end
    local hrp = getHRP()
    if not hrp then return slimes[1] end

    table.sort(slimes, function(a, b)
        local rarityA = blockRarityMap[a.Name] or "Common"
        local rarityB = blockRarityMap[b.Name] or "Common"
        local prioA = rarityPriority[rarityA] or 0
        local prioB = rarityPriority[rarityB] or 0
        if prioA ~= prioB then
            return prioA > prioB
        else
            return (getPosition(a) - hrp.Position).Magnitude < (getPosition(b) - hrp.Position).Magnitude
        end
    end)
    return slimes[1]
end

local function triggerPrompt(prompt)
    prompt.Enabled = true
    if fireproximityprompt then
        fireproximityprompt(prompt)
    elseif prompt.InputHoldBegin then
        prompt:InputHoldBegin()
        task.wait(0.1)
        prompt:InputHoldEnd()
    else
        pcall(function() prompt:Prompt() end)
    end
end

local function returnToSavedPosition()
    if savedSlimePos then
        local hrp = getHRP()
        if hrp then hrp.CFrame = CFrame.new(savedSlimePos) end
