task.spawn(function()
    while true do
        if autoCollectSlimesEnabled then
            local hrp = getHRP()
            if not hrp then
                clearBodyPosition()
                task.wait(0.5)
                continue
            end

            local target = getTopTarget()
            if target then
                local pos = getPosition(target)

                if (hrp.Position - pos).Magnitude > 30 then
                    hrp.CFrame = CFrame.new(pos)
                end

                if not bodyPos then
                    bodyPos = Instance.new("BodyPosition")
                    bodyPos.MaxForce = Vector3.new(0, math.huge, 0)
                    bodyPos.D = 500
                    bodyPos.P = 5000
                    bodyPos.Parent = hrp
                end
                bodyPos.Position = Vector3.new(hrp.Position.X, pos.Y, hrp.Position.Z)

                task.wait(0.5)

                local newTarget = getTopTarget()
                if newTarget and newTarget ~= target then
                    target = newTarget
                    pos = getPosition(target)
                    if (hrp.Position - pos).Magnitude > 30 then
                        hrp.CFrame = CFrame.new(pos)
                    end
                    bodyPos.Position = Vector3.new(hrp.Position.X, pos.Y, hrp.Position.Z)
                    task.wait(0.1)
                end

                local prompt = findPrompt(target)
                if prompt then
                    triggerPrompt(prompt)
                    task.wait(0.2)
                end

                clearBodyPosition()
                returnToSavedPosition()
                task.wait(0.2)
            else
                clearBodyPosition()
                task.wait(0.2)
            end
        else
            clearBodyPosition()
            task.wait(0.2)
        end
    end
end)
