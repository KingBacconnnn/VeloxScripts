    scale.Parent = button

    local busy = false
    local feedbackToken = 0

    local function restoreReady(token)
        task.delay(1.15, function()
            if not button.Parent or token ~= feedbackToken then return end
            label.Text = title
            status.Text = "READY • TAP"
            status.TextColor3 = accent
            badge.Text = "ON"
            badge.BackgroundColor3 = accent
            stroke.Color = accent
            stroke.Transparency = 0.22
            TweenService:Create(scale, TweenInfo.new(0.14), { Scale = 1 }):Play()
        end)
    end

    local function showFeedback(success, message)
        feedbackToken += 1
        local token = feedbackToken
        label.Text = success and ("✓ " .. title) or ("! " .. title)
        status.Text = success and "TAPPED • DONE" or ("FAILED • " .. (message or "Unavailable"))
        status.TextColor3 = success and Color3.fromRGB(104, 236, 132) or Color3.fromRGB(255, 110, 110)
        badge.Text = success and "DONE" or "ERR"
        badge.BackgroundColor3 = success and Color3.fromRGB(43, 170, 83) or Color3.fromRGB(190, 54, 54)
        stroke.Color = success and Color3.fromRGB(104, 236, 132) or Color3.fromRGB(255, 100, 100)
        stroke.Transparency = 0
        TweenService:Create(scale, TweenInfo.new(0.07), { Scale = 0.95 }):Play()
        task.delay(0.08, function()
            if scale.Parent and token == feedbackToken then
                TweenService:Create(scale, TweenInfo.new(0.13, Enum.EasingStyle.Back), { Scale = 1 }):Play()
            end
        end)
        restoreReady(token)
    end

    local dragging = false
    local dragStart = nil
    local startPos = nil
    local moved = false

    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = button.Position
        end
    end)

    button.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            if math.abs(delta.X) > 6 or math.abs(delta.Y) > 6 then
                moved = true
            end
            if moved then
                button.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end)

    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local wasMoved = moved
            dragging = false
            moved = false
            dragStart = nil
            startPos = nil
            if not wasMoved and not busy and button.Parent then
                busy = true
                status.Text = "WORKING • PLEASE WAIT"
                status.TextColor3 = Color3.fromRGB(220, 226, 238)
                badge.Text = "..."
                badge.BackgroundColor3 = Color3.fromRGB(92, 98, 112)
                stroke.Transparency = 0
                TweenService:Create(scale, TweenInfo.new(0.07), { Scale = 0.95 }):Play()
                task.spawn(function()
                    local ok, result, detail = pcall(action)
                    if not button.Parent then return end
                    if ok and result ~= false then
                        showFeedback(true, detail)
                    elseif ok then
                        showFeedback(false, detail or "Unavailable")
                    else
                        showFeedback(false, "Error")
                    end
                    busy = false
                end)
            end
        end
    end)

    button.MouseEnter:Connect(function()
        if busy or not button.Parent then return end
        TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1.02 }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.1), { Transparency = 0 }):Play()
    end)

    button.MouseLeave:Connect(function()
        if busy or not button.Parent then return end
        TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1 }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.1), { Transparency = 0.22 }):Play()
    end)

    FloatingButtons[name] = button
    return button
end

local function getLocalTool(toolName)
    local character = player.Character
    local backpack = player:FindFirstChildOfClass("Backpack")
    return (character and character:FindFirstChild(toolName))
        or (backpack and backpack:FindFirstChild(toolName))
end

local function useThrowKnifeButton()
    local knife = getLocalTool("Knife")
    local events = knife and knife:FindFirstChild("Events")
    local knifeThrown = events and events:FindFirstChild("KnifeThrown")
    if not knifeThrown then return false, "No knife" end
    local frontTarget, exactTarget = getClosestPlayerFrontCFrame()
    if not frontTarget or not exactTarget then return false, "No target" end
    knifeThrown:FireServer(frontTarget, exactTarget)
    return true
end

local function useShootButton()
    local gun = getLocalTool("Gun")
    local shoot = gun and gun:FindFirstChild("Shoot")
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local targetCFrame = gun and getMurdererFrontCFrame()
    if not shoot then return false, "No gun" end
    if not root then return false, "No character" end
    if not targetCFrame then return false, "No target" end
    shoot:FireServer(targetCFrame, root.CFrame)
    return true
end

local function useGunDropButton()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false, "No character" end
    local gunDrop = workspace:FindFirstChild("GunDrop", true)
    if not gunDrop or not gunDrop:IsA("BasePart") then return false, "Gun not found" end
    local oldCFrame = root.CFrame
    root.CFrame = gunDrop.CFrame + Vector3.new(0, 2, 0)
    task.wait(0.3)
    if root.Parent then root.CFrame = oldCFrame end
    return true
end

