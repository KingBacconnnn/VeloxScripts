RunService.Heartbeat:Connect(function()
    if not autoGunDrop or teleporting then return end
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local gunDrop = findGunDrop()
    if gunDrop then
        teleporting = true
        local oldPos = root.CFrame
        root.CFrame = gunDrop.CFrame + Vector3.new(0, 2, 0)
        task.wait(0.5)
        if root then root.CFrame = oldPos end
        task.wait(0.3)
        teleporting = false
    end
end)

local roleESP = { murderer = false, sheriff = false, innocent = false }
local gunDropEnabled = false
local ESP_PREFIX = "MurderMystery2ESP_"

local function clearRoleESP(char)
    if not char then return end
    for _, obj in ipairs(char:GetChildren()) do
        if obj.Name:sub(1, #ESP_PREFIX) == ESP_PREFIX then obj:Destroy() end
    end
end

local function getPlayerRole(plr)
    local char = plr.Character
    local backpack = plr:FindFirstChild("Backpack")
    local hasKnife = (char and char:FindFirstChild("Knife")) or (backpack and backpack:FindFirstChild("Knife"))
    local hasGun = (char and char:FindFirstChild("Gun")) or (backpack and backpack:FindFirstChild("Gun"))
    if hasKnife then return "murderer" end
    if hasGun then return "sheriff" end
    return "innocent"
end

local function addRoleESP(plr, color, text)
    local char = plr.Character
    if not char then return end
    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not head then return end

    clearRoleESP(char)

    local highlight = Instance.new("Highlight")
    highlight.Name = ESP_PREFIX .. "Highlight"
    highlight.FillTransparency = 1
    highlight.OutlineColor = color
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = char
    highlight.Parent = char

    local billboard = Instance.new("BillboardGui")
    billboard.Name = ESP_PREFIX .. "Label"
    billboard.Size = UDim2.fromOffset(140, 32)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = head
    billboard.Parent = char

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Parent = billboard
end

local function updateRoleESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local role = getPlayerRole(plr)
            clearRoleESP(plr.Character)
            if role == "murderer" and roleESP.murderer then
                addRoleESP(plr, Color3.fromRGB(255, 70, 70), "Murderer")
            elseif role == "sheriff" and roleESP.sheriff then
                addRoleESP(plr, Color3.fromRGB(80, 160, 255), "Sheriff")
            elseif role == "innocent" and roleESP.innocent then
                addRoleESP(plr, Color3.fromRGB(90, 255, 150), "Innocent")
            end
        end
    end
end

local function clearGunDropESP()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local highlight = obj:FindFirstChild(ESP_PREFIX .. "GunHighlight")
            local label = obj:FindFirstChild(ESP_PREFIX .. "GunLabel")
            if highlight then highlight:Destroy() end
            if label then label:Destroy() end
        end
    end
end

local function updateGunDropESP()
    clearGunDropESP()
    if not gunDropEnabled then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "GunDrop" and obj:IsA("BasePart") then
            local highlight = Instance.new("Highlight")
            highlight.Name = ESP_PREFIX .. "GunHighlight"
            highlight.FillTransparency = 1
            highlight.OutlineColor = Color3.fromRGB(255, 220, 70)
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Adornee = obj
            highlight.Parent = obj

            local billboard = Instance.new("BillboardGui")
            billboard.Name = ESP_PREFIX .. "GunLabel"
            billboard.Size = UDim2.fromOffset(140, 28)
            billboard.StudsOffset = Vector3.new(0, 2.5, 0)
            billboard.AlwaysOnTop = true
            billboard.Adornee = obj
            billboard.Parent = obj

            local label = Instance.new("TextLabel")
            label.Size = UDim2.fromScale(1, 1)
            label.BackgroundTransparency = 1
            label.Text = "Sheriff Gun"
            label.TextColor3 = Color3.fromRGB(255, 220, 70)
            label.TextStrokeTransparency = 0
            label.Font = Enum.Font.GothamBold
            label.TextSize = 14
            label.Parent = billboard
        end
    end
end

