player.CharacterAdded:Connect(bindCharacter)

local function notify(title, content, icon, duration)
    pcall(function()
        WindUI:Notify({
            Title = title,
            Content = content,
            Duration = duration or 2,
            Icon = icon or "ghost",
        })
    end)
end

local function notifyThrottled(title, content, icon, duration, cooldown)
    cooldown = cooldown or 3
    if os.clock() - lastScanNotify < cooldown then return end
    lastScanNotify = os.clock()
    notify(title, content, icon, duration)
end

local function resolveRuntime()
    if cachedRuntime and cachedRuntime.Parent then return cachedRuntime end
    local world = workspace:FindFirstChild(WORLD_NAME)
    if not world then
        cachedRuntime = nil
        return nil
    end
    cachedRuntime = world:FindFirstChild(RUNTIME_NAME)
    return cachedRuntime
end

local function isHalloweenWorldPresent()
    return workspace:FindFirstChild(WORLD_NAME) ~= nil
end

local function getTierNamesFromConfig()
    if not TIER_TEXT_FX then return {} end
    local names = {}
    local ok, source = pcall(function()
        local env = getfenv(TIER_TEXT_FX.tierColorAt)
        return env
    end)
    if ok and type(source) == "table" then
        for key, value in pairs(source) do
            if type(key) == "string" and type(value) == "table" and value.palette then
                names[#names + 1] = key
            end
        end
    end
    return names
end

local function isValidTier(name)
    if type(name) ~= "string" or name == "" then return false end
    if not TIER_TEXT_FX or not TIER_TEXT_FX.tierColorAt then return true end
    local ok, color = pcall(TIER_TEXT_FX.tierColorAt, name, 0)
    return ok and color ~= nil
end

local function getTier(model)
    local tier = model:GetAttribute("Tier")
    if type(tier) == "string" and tier ~= "" then return tier end
    tier = model:GetAttribute("TierName")
    if type(tier) == "string" and tier ~= "" then return tier end
    tier = model:GetAttribute("Rarity")
    if type(tier) == "string" and tier ~= "" then return tier end
    tier = model:GetAttribute("EggTier")
    if type(tier) == "string" and tier ~= "" then return tier end
    return "Unknown"
end

local function findPrompt(model)
    if not model then return nil, nil end
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if not root or not root:IsA("BasePart") then return nil, nil end
    local prompt = root:FindFirstChildWhichIsA("ProximityPrompt", true)
        or model:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt then return nil, nil end
    return root, prompt
end

local function isTargetNPC(model)
    if not model or not model:IsA("Model") then return false end
    local root, prompt = findPrompt(model)
    return root ~= nil and prompt ~= nil
end

local function matchesSelected(tier)
    if #state.selected == 0 then return true end
    return state.selectedSet[tier] == true
end

local function processNPC(model)
    if not state.active then return end
    if not cachedHrp or not cachedHrp.Parent then return end
    if not model or not model.Parent or state.claimed[model] then return end

    local tier = getTier(model)
    if not matchesSelected(tier) then return end

    local root, prompt = findPrompt(model)
    if not root or not prompt then return end

    state.claimed[model] = true
    cachedHrp.CFrame = root.CFrame + TELEPORT_OFFSET
    cachedHrp.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.2)

    if not cachedHrp or not cachedHrp.Parent then
        state.claimed[model] = nil
        return
    end

    pcall(function()
        prompt.Enabled = true
        prompt.Visible = true
        prompt.HoldDuration = 0
    end)

    for _ = 1, FIRE_ATTEMPTS do
        pcall(fireproximityprompt, prompt)
        task.wait(FIRE_GAP)
    end

    notify("Egg Haunted", ("%s captured — %s tier"):format(model.Name, tier), "ghost", 1.5)

    if cachedHrp and cachedHrp.Parent then
        cachedHrp.CFrame = CFrame.new(HOME)
    end
    task.wait(0.15)
end

local function runQueue()
    if state.running or not state.active then return end
    state.running = true
    task.spawn(function()
        while state.active do
            local model = table.remove(state.queue, 1)
            if not model then break end
            state.queueSet[model] = nil
            if not cachedHrp or not cachedHrp.Parent then
                task.wait(0.25)
            else
                processNPC(model)
            end
        end
        state.running = false
    end)
end

local function enqueue(model)
    if not state.active or not model then return end
    if state.claimed[model] or state.queueSet[model] then return end
    if not isTargetNPC(model) then return end
    if not matchesSelected(getTier(model)) then return end
    state.queueSet[model] = true
    table.insert(state.queue, model)
    runQueue()
end

local function watchNPC(model)
    if state.watched[model] then return end
    state.watched[model] = true

    model:GetAttributeChangedSignal("Tier"):Connect(function()
        state.claimed[model] = nil
        if state.active then enqueue(model) end
    end)
    model:GetAttributeChangedSignal("TierName"):Connect(function()
        state.claimed[model] = nil
        if state.active then enqueue(model) end
    end)
    model:GetAttributeChangedSignal("Rarity"):Connect(function()
        state.claimed[model] = nil
        if state.active then enqueue(model) end
    end)
    model:GetAttributeChangedSignal("EggTier"):Connect(function()
        state.claimed[model] = nil
        if state.active then enqueue(model) end
    end)

    model.ChildAdded:Connect(function()
        if state.active then
            state.claimed[model] = nil
            enqueue(model)
        end
    end)

    model.AncestryChanged:Connect(function(_, parent)
        if not parent then
            state.claimed[model] = nil
            state.watched[model] = nil
            state.queueSet[model] = nil
        end
    end)
end

local function scanAll()
    local runtime = resolveRuntime()
    if not runtime then return 0 end

    local found = 0
    for _, model in ipairs(runtime:GetChildren()) do
        if model:IsA("Model") then
            if not state.watched[model] then
                watchNPC(model)
            end
            if isTargetNPC(model) then
                found += 1
                if state.active then
                    enqueue(model)
                end
            end
        end
    end
    return found
end

local function discoverTiers()
    local found = {}
    local runtime = resolveRuntime()

    if runtime then
        for _, model in ipairs(runtime:GetChildren()) do
            if model:IsA("Model") and isTargetNPC(model) then
                local tier = getTier(model)
                if tier ~= "Unknown" and isValidTier(tier) then
                    found[tier] = true
                end
            end
        end
    end

    if next(found) == nil then
        local fromConfig = getTierNamesFromConfig()
        if #fromConfig > 0 then
            for _, tier in ipairs(fromConfig) do
                found[tier] = true
            end
        end
    end

    local list = {}
    for tier in pairs(found) do
        table.insert(list, tier)
    end

    table.sort(list)
    return list
end

local function scanExistingRarities()
    if not isHalloweenWorldPresent() then
        notifyThrottled(
            "Not in Halloween World",
            "Enter the Halloween World first, then scan again.",
            "alert-triangle",
            3
        )
        return nil
    end

    local runtime = resolveRuntime()
    if not runtime then
        notifyThrottled("Scanner", "Halloween World is still loading, try again in a moment", "clock", 3)
        return nil
    end

    local tierCounts = {}
    local totalNPCs = 0
    local validNPCs = 0

    for _, model in ipairs(runtime:GetChildren()) do
        if model:IsA("Model") then
            totalNPCs += 1
            if isTargetNPC(model) then
                validNPCs += 1
                local tier = getTier(model)
                tierCounts[tier] = (tierCounts[tier] or 0) + 1
            end
        end
    end

    if validNPCs == 0 then
        notifyThrottled(
            "Scanner",
            ("Found %d models, 0 valid NPCs yet — world still streaming"):format(totalNPCs),
            "clock",
            3
        )
        return nil
    end

    local sorted = {}
    for tier, count in pairs(tierCounts) do
        sorted[#sorted + 1] = { tier = tier, count = count }
    end
    table.sort(sorted, function(a, b)
        return a.tier < b.tier
    end)

    print("[HauntedScanner] ================================================")
    print(("[HauntedScanner] Scanned %d models | %d valid NPCs"):format(totalNPCs, validNPCs))
    print("[HauntedScanner] Tiers currently in the world:")
    for _, entry in ipairs(sorted) do
        print(("[HauntedScanner]   %-14s × %d"):format(entry.tier, entry.count))
    end
    print("[HauntedScanner] ================================================")

    local summary = {}
    for i = 1, math.min(#sorted, 5) do
        summary[#summary + 1] = ("%s×%d"):format(sorted[i].tier, sorted[i].count)
    end
    local summaryText = table.concat(summary, "  ")
    if #sorted > 5 then
        summaryText = summaryText .. ("  (+%d more)"):format(#sorted - 5)
    end

    notify(
        "Scan Complete",
        ("%d NPCs across %d tiers\n%s"):format(validNPCs, #sorted, summaryText),
        "check",
        5
    )
    return sorted
end

