workspace.DescendantAdded:Connect(function(d)
    if d:IsA("BasePart") and d.Name == "Claim Button" then
        if not buttonSet[d] then
            buttonSet[d] = true
            buttonCache[#buttonCache + 1] = d
        end
    end
    if d:IsA("Model") then
        watchNest(d)
        if state.nest.active and isEgg(d) then
            task.delay(0.15, function()
                if d.Parent then enqueueNest(d) end
            end)
        end
        if state.halloweenEgg.active then
            watchHalloweenNPC(d)
            task.delay(0.15, function()
                if d.Parent then enqueueHalloweenNPC(d) end
            end)
        end
    elseif d:IsA("HumanoidRootPart") and d.Parent and isEgg(d.Parent) then
        watchNest(d.Parent)
        if state.nest.active then
            task.delay(0.15, function()
                if d.Parent then enqueueNest(d.Parent) end
            end)
        end
    end
end)

workspace.DescendantRemoving:Connect(function(d)
    if buttonSet[d] then
        buttonSet[d] = nil
        local idx = table.find(buttonCache, d)
        if idx then table.remove(buttonCache, idx) end
    end
    state.nest.claimed[d] = nil
    state.nest.watched[d] = nil
    state.nest.queueSet[d] = nil
    state.halloweenEgg.claimed[d] = nil
    state.halloweenEgg.watched[d] = nil
    state.halloweenEgg.queueSet[d] = nil
end)

workspace.ChildAdded:Connect(function(child)
    if child.Name ~= WORLD_NAME then return end
    task.spawn(function()
        forceStreamHalloweenWorld(STREAM_WAIT_TIMEOUT)
        scanHalloweenNPCs()
    end)
end)

local function attachRuntimeToWatcher(runtime)
    if not runtime then return end
    if runtime:GetAttribute("HauntedWatcherAttached") then return end
    runtime:SetAttribute("HauntedWatcherAttached", true)

    runtime.DescendantAdded:Connect(function(d)
        if d:IsA("Model") then
            watchHalloweenNPC(d)
            if state.halloweenEgg.active then
                task.delay(0.15, function()
                    if d.Parent then enqueueHalloweenNPC(d) end
                end)
            end
        elseif d:IsA("ProximityPrompt") and d.Parent and d.Parent.Name == "HumanoidRootPart" then
            local model = d.Parent.Parent
            if model and model:IsA("Model") then
                watchHalloweenNPC(model)
                if state.halloweenEgg.active then
                    task.delay(0.15, function()
                        if model.Parent then enqueueHalloweenNPC(model) end
                    end)
                end
            end
        end
    end)
end

task.spawn(function()
    while task.wait(2) do
        local rt = resolveHalloweenRuntime()
        if rt then
            attachRuntimeToWatcher(rt)
        end
    end
end)
