local function hasCandyKeeperNearby() return isNearNpc("CandyKeeper", 25) end

local function shopRemainingRoom()
    local t = state.halloweenTrader.data
    if t.windowEndsAt <= 0 or t.windowEndsAt <= getTraderServerTime() then return t.windowCap end
    return math.max(0, t.windowCap - t.converted)
end

local function shopAffordableRoom()
    local rate = state.halloweenTrader.data.rate
    if rate <= 0 then return 0 end
    return math.floor((getMoney() or 0) / rate)
end

local function resolveExchangeAmount()
    local room = math.min(shopRemainingRoom(), shopAffordableRoom())
    if room <= 0 then return 0 end
    if state.halloweenTrader.exchangeAmount == 0 then return room end
    return math.min(room, state.halloweenTrader.exchangeAmount)
end

local function canBuyShopItem(key)
    local cfg = shopItemByKey[key]
    if not cfg then return false end
    local live = state.halloweenCandy.liveShop[key]
    local price = (live and live.price) or cfg.price or 0
    local available = (not live) or live.available ~= false
    local full = live and live.full == true
    local owned = (live and live.owned) or 0
    local max = (live and live.max) or (HalloweenConfig.GiftCharm and HalloweenConfig.GiftCharm.MaxOwned) or 99
    local dailyBought = (live and live.dailyBought) or 0
    local dailyCap = (live and live.dailyCap) or (HalloweenConfig.ShopDaily and HalloweenConfig.ShopDaily.Cap) or 5
    local dailyEndsAt = (live and live.dailyEndsAt) or 0
    local endsAt = (live and live.endsAt) or 0

    if not available then return false end
    if getShopServerTime() <= dailyEndsAt and dailyBought >= dailyCap then return false end
    if key == "GiftCharm" and owned >= max then return false end
    if cfg.kind ~= "giftcharm" then
        local activeEndsAt = math.max(endsAt, getShopServerTime())
        local remaining = math.max(0, activeEndsAt - getShopServerTime())
        local added = (cfg.minutes or 0) * 60
        if full or remaining + added > state.halloweenCandy.maxStackMinutes * 60 + 1 then return false end
    end
    if getCandy() < price then return false end
    return true
end

local function canBuyLadder(entry)
    if type(entry) ~= "table" then return false end
    if entry.state ~= "next" then return false end
    if type(entry.buyKey) ~= "string" then return false end
    local price = tonumber(entry.price) or 0
    if price <= 0 then return false end
    if getCandy() < price then return false end
    return true
end

local function tryShopBuy(key)
    local t = state.halloweenCandy
    local now = os.clock()
    if now - t.lastBuy < 0.55 then return false end
    t.lastBuy = now
    return safeFire(buyRemote, key)
end

local function autoBuyShopItems()
    if not state.halloweenCandy.autoShop then return end
    if not hasCandyKeeperNearby() then return end
    local list = #state.halloweenCandy.selectedShop > 0 and state.halloweenCandy.selectedShop or shopItemKeys
    for _, key in ipairs(list) do
        if canBuyShopItem(key) then
            tryShopBuy(key)
            return
        end
    end
