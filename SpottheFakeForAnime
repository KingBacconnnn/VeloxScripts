MainTab:Toggle({
    Title = "Awaken the Reaper",
    Desc = "Wander the Halloween world, seize matching Eggs from cursed Nests, then vanish home.",
    Icon = "ghost",
    Type = "Checkbox",
    Value = false,
    Callback = function(value)
        state.active = value == true
        if state.active then
            notify("The Reaper Awakens", "The hunt begins…", "ghost", 2)
            scanAll()
        else
            notify("The Reaper Rests", "Returning to the shadows.", "moon", 2)
            table.clear(state.queue)
            table.clear(state.queueSet)
        end
    end,
})

local scanAccumulator = 0
RunService.Heartbeat:Connect(function(dt)
    if not state.active then return end
    scanAccumulator += dt
    if scanAccumulator < SCAN_INTERVAL then return end
    scanAccumulator = 0
    scanAll()
end)

local function attachRuntime(runtime)
    if not runtime then return end
    runtime.DescendantAdded:Connect(function(d)
        if d:IsA("Model") then
            watchNPC(d)
            if state.active then
                task.delay(0.15, function()
                    if d.Parent then enqueue(d) end
                end)
            end
        elseif d:IsA("ProximityPrompt") and d.Parent and d.Parent.Name == "HumanoidRootPart" then
            local model = d.Parent.Parent
            if model and model:IsA("Model") then
                watchNPC(model)
                if state.active then
                    task.delay(0.15, function()
                        if model.Parent then enqueue(model) end
                    end)
                end
            end
        end
    end)
end

local rt = resolveRuntime()
if rt then
    attachRuntime(rt)
else
    local waitingForWorld = true
    workspace.ChildAdded:Connect(function(child)
        if not waitingForWorld then return end
        if child.Name ~= WORLD_NAME then return end
        waitingForWorld = false
        task.wait(0.5)
        local newRt = resolveRuntime()
        if newRt then attachRuntime(newRt) end
        scanAll()
    end)
end

scanAll()
