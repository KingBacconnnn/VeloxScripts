    return ok and tonumber(result) or #TreadmillConfig.Treadmills
end

local function getNextTreadmill()
    local level = getTreadmillLevel()
    local max = treadmillMax()
    if level >= max then return nil, level, max end
    return TreadmillConfig.Treadmills[level + 1], level, max
end

local function rebirthLevel()
    local ok, result = pcall(function() return RebirthConfig.levelOf(player) end)
    return ok and tonumber(result) or 0
end

local function rebirthMax()
    return tonumber(RebirthConfig.MaxRebirths) or 99
end

local function rebirthReady()
    local ok, result = pcall(function()
        if type(player:GetAttribute("RebirthLevel")) ~= "number" then return false end
        if player:GetAttribute("OnTreadmill") == true then return false end
        if rebirthLevel() >= rebirthMax() then return false end
        local base = tonumber(player:GetAttribute("BaseLevel")) or 0
        local tread = tonumber(player:GetAttribute("TreadmillLevel")) or 1
        local progress = RebirthConfig.progress(base, tread)
        return type(progress) == "table" and progress.met == true
    end)
    return ok and result == true
end

local function canUseTreadmill(tread)
    if not tread then return false end
    if tread.rebirth == true and rebirthLevel() <= 0 then return false end
    if tread.soldBy == "CandyKeeper" then return false end
    return true
end

local function upgradeTreadmill()
    if state.treadmill.busy or not state.treadmill.autoBuy then return end
    local nextT, before = getNextTreadmill()
    if not canUseTreadmill(nextT) then return end

    local money = getMoney()
    if money ~= nil and nextT.cost ~= nil and money < nextT.cost then
        if os.clock() - state.treadmill.lastNotEnough > 5 then
            state.treadmill.lastNotEnough = os.clock()
            notify("Not Enough Money", ("Need $%s, have $%s"):format(tostring(nextT.cost), tostring(money)), "wallet", 2)
        end
        return
    end

    state.treadmill.busy = true
    local fired = safeFire(treadmillRemote)
    if fired then
        for _ = 1, 10 do
            task.wait(0.12)
            if getTreadmillLevel() > before then
                state.treadmill.busy = false
                return
            end
        end
    end
    state.treadmill.busy = false
end

local function getOwnedTrails(attr)
    local owned = {}
    local value = player:GetAttribute(attr or "OwnedTrails")
    if type(value) ~= "string" then return owned end
    for id in string.gmatch(value, "[^,]+") do owned[id] = true end
    return owned
end

local function getEquippedTrail(attr)
    return tostring(player:GetAttribute(attr or "EquippedTrail") or "")
end

local function buyTrails()
    if not state.trail.autoBuy or state.trail.busy then return end
    if type(TreadmillConfig.Trails) ~= "table" then return end
    state.trail.busy = true
    local owned = getOwnedTrails()
    for _, trail in ipairs(TreadmillConfig.Trails) do
        if not trail or not trail.id then continue end
        if owned[trail.id] then continue end
        if trail.rebirth == true and rebirthLevel() <= 0 then break end
        if trail.exclusive or trail.soldBy == "CandyKeeper" then continue end
        local ok, unlocked = pcall(TreadmillConfig.trailUnlocked, trail.id, owned)
        if not ok or not unlocked then break end
        if safeFire(trailBuyRemote, trail.id) then
            task.wait(0.35)
            owned = getOwnedTrails()
        end
    end
    state.trail.busy = false
end

local function equipBestTrail()
    if not state.trail.autoEquip or state.trail.busy then return end
    if type(TreadmillConfig.Trails) ~= "table" then return end
    local owned = getOwnedTrails()
    local equipped = getEquippedTrail()
    local bestId, bestMult = nil, -math.huge
    for _, trail in ipairs(TreadmillConfig.Trails) do
        if trail and owned[trail.id] then
            local mult = tonumber(trail.mult) or 0
            if mult > bestMult then
                bestMult = mult
                bestId = trail.id
            end
        end
    end
    if bestId and equipped ~= bestId then safeFire(trailEquipRemote, bestId) end
end

local function doRebirth()
    if state.rebirth.firing then return end
    if os.clock() - state.rebirth.lastFire < 3 then return end
    if not rebirthReady() then return end
    state.rebirth.firing = true
    state.rebirth.lastFire = os.clock()
    local before = rebirthLevel()
    safeFire(rebirthRemote)
    task.wait(1)
    local after = rebirthLevel()
    state.rebirth.firing = false
    notify(
        after > before and "Rebirth Success" or "Rebirth Pending",
        after > before and ("Level %d to %d"):format(before, after) or "Request sent",
        after > before and "star" or "clock",
        2
    )
end

