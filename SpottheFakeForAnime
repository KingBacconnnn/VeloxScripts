local function resolveHalloweenRuntime()
    if cachedRuntime and cachedRuntime.Parent then return cachedRuntime end
    if not HalloweenConfig then return nil end
    local world = workspace:FindFirstChild(HalloweenConfig.WorldName)
    if not world then cachedRuntime = nil return nil end
    cachedRuntime = world:FindFirstChild(RUNTIME_NAME)
    return cachedRuntime
end

local function forceStreamHalloweenWorld(timeout)
    timeout = timeout or STREAM_WAIT_TIMEOUT
    if not HalloweenConfig then return nil end
    if not workspace.StreamingEnabled then return resolveHalloweenRuntime() end

    local world = workspace:FindFirstChild(HalloweenConfig.WorldName)
    if not world then return nil end

    local started = os.clock()
    while os.clock() - started < timeout do
        local runtime = resolveHalloweenRuntime()
        if runtime and #runtime:GetChildren() > 0 then return runtime end

        pcall(function()
            player:RequestStreamAroundAsync(world:GetPivot().Position)
        end)

        task.wait(0.35)
    end

    return resolveHalloweenRuntime()
end

local function isValidTier(name)
    if type(name) ~= "string" or name == "" then return false end
    if not TIER_TEXT_FX or not TIER_TEXT_FX.tierColorAt then return true end
    local ok, color = pcall(TIER_TEXT_FX.tierColorAt, name, 0)
    return ok and color ~= nil
end

local function getHalloweenTier(model)
    local tier = model:GetAttribute("Tier")
    if type(tier) == "string" and tier ~= "" then return tier end
    tier = model:GetAttribute("TierName")
    if type(tier) == "string" and tier ~= "" then return tier end
    tier = model:GetAttribute("Rarity")
    if type(tier) == "string" and tier ~= "" then return tier end
    tier = model:GetAttribute("EggTier")
    if type(tier) == "string" and tier ~= "" then return tier end
    return "Unknown"
end

local function findPrompt(model)
    if not model then return nil, nil end
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if not root or not root:IsA("BasePart") then return nil, nil end
    local prompt = root:FindFirstChildWhichIsA("ProximityPrompt", true)
        or model:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt then return nil, nil end
    return root, prompt
end

local function isHalloweenTargetNPC(model)
    if not model or not model:IsA("Model") then return false end
    local root, prompt = findPrompt(model)
    return root ~= nil and prompt ~= nil
end

local function matchesHalloweenTier(tier)
    if #state.halloweenEgg.selected == 0 then return true end
    return state.halloweenEgg.selectedSet[tier] == true
end

local function processHalloweenNPC(model)
    if not state.halloweenEgg.active or not cachedHrp or not cachedHrp.Parent then return end
    if not model or not model.Parent or state.halloweenEgg.claimed[model] then return end
    local tier = getHalloweenTier(model)
    if not matchesHalloweenTier(tier) then return end
    local root, prompt = findPrompt(model)
    if not root or not prompt then return end

    state.halloweenEgg.claimed[model] = true
    cachedHrp.CFrame = root.CFrame + TELEPORT_OFFSET
    cachedHrp.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.2)

    if not cachedHrp or not cachedHrp.Parent then
        state.halloweenEgg.claimed[model] = nil
        return
    end

    pcall(function()
        prompt.Enabled = true
        prompt.Visible = true
        prompt.HoldDuration = 0
    end)
    for _ = 1, FIRE_ATTEMPTS do
        pcall(fireproximityprompt, prompt)
        task.wait(FIRE_GAP)
    end

    notify("Egg Haunted", ("%s captured — %s tier"):format(model.Name, tier), "ghost", 1.5)

    if cachedHrp and cachedHrp.Parent then
        cachedHrp.CFrame = CFrame.new(HOME)
    end
    task.wait(0.15)
end

local function runHalloweenQueue()
    if state.halloweenEgg.running or not state.halloweenEgg.active then return end
    state.halloweenEgg.running = true
    task.spawn(function()
        while state.halloweenEgg.active do
            local model = table.remove(state.halloweenEgg.queue, 1)
            if not model then break end
            state.halloweenEgg.queueSet[model] = nil
            if not cachedHrp or not cachedHrp.Parent then task.wait(0.25)
            else processHalloweenNPC(model) end
        end
        state.halloweenEgg.running = false
    end)
end

local function enqueueHalloweenNPC(model)
    if not state.halloweenEgg.active or not model then return end
    if state.halloweenEgg.claimed[model] or state.halloweenEgg.queueSet[model] then return end
    if not isHalloweenTargetNPC(model) then return end
    if not matchesHalloweenTier(getHalloweenTier(model)) then return end
    state.halloweenEgg.queueSet[model] = true
    state.halloweenEgg.queue[#state.halloweenEgg.queue + 1] = model
    runHalloweenQueue()
end

local function watchHalloweenNPC(model)
    if state.halloweenEgg.watched[model] then return end
    state.halloweenEgg.watched[model] = true
    model:GetAttributeChangedSignal("Tier"):Connect(function()
        state.halloweenEgg.claimed[model] = nil
        if state.halloweenEgg.active then enqueueHalloweenNPC(model) end
    end)
    model.ChildAdded:Connect(function()
        if state.halloweenEgg.active then
            state.halloweenEgg.claimed[model] = nil
            enqueueHalloweenNPC(model)
        end
    end)
    model.AncestryChanged:Connect(function(_, parent)
        if not parent then
            state.halloweenEgg.claimed[model] = nil
            state.halloweenEgg.watched[model] = nil
            state.halloweenEgg.queueSet[model] = nil
        end
    end)
end

local function scanHalloweenNPCs()
    local runtime = resolveHalloweenRuntime()
    if not runtime then
        if workspace.StreamingEnabled and HalloweenConfig then
            local world = workspace:FindFirstChild(HalloweenConfig.WorldName)
            if world then
                pcall(function() player:RequestStreamAroundAsync(world:GetPivot().Position) end)
            end
        end
        return 0
    end

    local found = 0
    for _, model in ipairs(runtime:GetChildren()) do
        if model:IsA("Model") then
            if not state.halloweenEgg.watched[model] then watchHalloweenNPC(model) end
            if isHalloweenTargetNPC(model) then
                found += 1
                if state.halloweenEgg.active then enqueueHalloweenNPC(model) end
            end
        end
    end

    if found == 0 and workspace.StreamingEnabled then
        pcall(function() player:RequestStreamAroundAsync(runtime:GetPivot().Position) end)
    end
    return found
end

local function discoverHalloweenTiers()
    local found = {}
    local runtime = resolveHalloweenRuntime()
    if runtime then
        for _, model in ipairs(runtime:GetChildren()) do
            if model:IsA("Model") and isHalloweenTargetNPC(model) then
                local tier = getHalloweenTier(model)
                if tier ~= "Unknown" and isValidTier(tier) then found[tier] = true end
            end
        end
    end
    if next(found) == nil then
        for _, tier in ipairs(FALLBACK_TIERS) do found[tier] = true end
    end
    local list = {}
    for tier in pairs(found) do list[#list + 1] = tier end
    table.sort(list, function(a, b)
        local ai = FALLBACK_TIER_INDEX[a] or math.huge
        local bi = FALLBACK_TIER_INDEX[b] or math.huge
        if ai == bi then return a < b end
        return ai < bi
    end)
    return list
end

local function scanExistingRarities()
    local runtime = forceStreamHalloweenWorld(STREAM_WAIT_TIMEOUT)
    if not runtime then
        notifyThrottled("Scanner", "Halloween World is still loading, try again in a moment", "clock", 3)
        return nil
    end

    local tierCounts = {}
    local totalNPCs = 0
    local validNPCs = 0

    for _, model in ipairs(runtime:GetChildren()) do
        if model:IsA("Model") then
            totalNPCs += 1
            if isHalloweenTargetNPC(model) then
                validNPCs += 1
                local tier = getHalloweenTier(model)
                tierCounts[tier] = (tierCounts[tier] or 0) + 1
            end
        end
    end

    if validNPCs == 0 then
        notifyThrottled(
            "Scanner",
            ("Found %d models, 0 valid NPCs yet — world still streaming"):format(totalNPCs),
            "clock",
            3
        )
        return nil
    end

    local sorted = {}
    for tier, count in pairs(tierCounts) do
        sorted[#sorted + 1] = { tier = tier, count = count }
    end
    table.sort(sorted, function(a, b)
        local ai = FALLBACK_TIER_INDEX[a.tier] or math.huge
        local bi = FALLBACK_TIER_INDEX[b.tier] or math.huge
        if ai == bi then return a.tier < b.tier end
        return ai < bi
    end)

    print("[HauntedScanner] ================================================")
    print(("[HauntedScanner] Scanned %d models | %d valid NPCs"):format(totalNPCs, validNPCs))
    print("[HauntedScanner] Tiers currently in the world:")
    for _, entry in ipairs(sorted) do
        print(("[HauntedScanner]   %-14s × %d"):format(entry.tier, entry.count))
    end
    print("[HauntedScanner] ================================================")

    local summary = {}
    for i = 1, math.min(#sorted, 5) do
        summary[#summary + 1] = ("%s×%d"):format(sorted[i].tier, sorted[i].count)
    end
    local summaryText = table.concat(summary, "  ")
    if #sorted > 5 then
        summaryText = summaryText .. ("  (+%d more)"):format(#sorted - 5)
    end

    notify(
        "Scan Complete",
        ("%d NPCs across %d tiers\n%s"):format(validNPCs, #sorted, summaryText),
        "check",
        5
    )
    return sorted
end

