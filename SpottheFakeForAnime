local heartbeatAcc = 0
local hMoneyAcc = 0
local halloweenSyncAcc = 0
local halloweenScanAcc = 0

RunService.Heartbeat:Connect(function(dt)
    heartbeatAcc += dt
    hMoneyAcc += dt
    halloweenSyncAcc += dt
    halloweenScanAcc += dt

    if moneyEnabled and hMoneyAcc >= 0.05 then
        hMoneyAcc = 0
        local n = collectMoneyOnce()
        if state.halloweenMoney.active then
            HMoneyStatus:SetDesc(("Claim Buttons found: %d"):format(n))
        end
    end

    if state.halloweenEgg.active and halloweenScanAcc >= 1.5 then
        halloweenScanAcc = 0
        if not cachedRuntime or not cachedRuntime.Parent then
            task.spawn(function()
                forceStreamHalloweenWorld(STREAM_WAIT_TIMEOUT)
            end)
        else
            scanHalloweenNPCs()
        end
    end

    if halloweenSyncAcc >= 5 then
        halloweenSyncAcc = 0
        if HalloweenConfig and isInWorld() then
            if hasCandyKeeperNearby() and buyRemote then safeFire(buyRemote, "sync") end
            local npcId = HalloweenConfig.Trader and HalloweenConfig.Trader.NpcId or "Vlad"
            if isNearNpc(npcId, 25) and traderRemote then safeFire(traderRemote, "sync") end
        end
    end

    if heartbeatAcc < 0.5 then return end
    heartbeatAcc = 0

    if state.treadmill.autoBuy then pcall(upgradeTreadmill) end
    if state.trail.autoBuy then pcall(buyTrails) end
    if state.trail.autoEquip then pcall(equipBestTrail) end
    if state.rebirth.auto and rebirthReady() then task.spawn(doRebirth) end
    if state.daily.autoClaim then pcall(tryClaimDaily) end

    if state.base.auto then
        local now = os.clock()
        if now >= state.base.backoff and now - state.base.lastFire >= 1 then
            state.base.lastFire = now
            task.spawn(fireBaseWithCheck)
        end
    end

    if state.daily.currentDay then
        local left = dailySecondsLeft()
        DailyStatus:SetDesc(
            left == 0 and ("Day %d ready to claim"):format(state.daily.currentDay)
            or ("Day %d ready in %s"):format(state.daily.currentDay, formatTime(left))
        )
    end

    if HalloweenConfig and isInWorld() then
        pcall(autoBuyShopItems)
        pcall(autoBuyHalloweenTreadmills)
        pcall(autoBuyHalloweenTrails)
        pcall(autoEquipHalloweenTrail)
        pcall(autoTraderExchange)
        pcall(autoTraderClaim)
        pcall(autoEquipBestBat)
        pcall(autoActivateAura)
    end
end)

