local function findNpcRoot(npcId)
    if not HalloweenConfig then return nil end
    for _, npc in ipairs(CollectionService:GetTagged(HalloweenConfig.NpcTag)) do
        if npc:IsA("Model") then
            local id = npc:GetAttribute("NpcId")
            if type(id) ~= "string" or id == "" then
                for _, def in ipairs(HalloweenConfig.Npcs) do
                    if npc.Name == def.model or npc.Name == def.id then
                        id = def.id
                        break
                    end
                end
            end
            if id == npcId then
                return npc.PrimaryPart or npc:FindFirstChild("HumanoidRootPart")
            end
        end
    end
    return nil
end

local function isNearNpc(npcId, proximity)
    if not cachedHrp or not cachedHrp.Parent then return false end
    local root = findNpcRoot(npcId)
    if not root then return false end
    return (root.Position - cachedHrp.Position).Magnitude <= (proximity or 25)
end

local shopItemKeys = {}
local shopItemByKey = {}
if HalloweenConfig then
    for _, item in ipairs(HalloweenConfig.Shop) do
