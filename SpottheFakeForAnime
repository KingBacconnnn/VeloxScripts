local function waitForRoot(model, timeout)
    local elapsed = 0
    while elapsed < timeout do
        local root = model:FindFirstChild("HumanoidRootPart")
        if root then return root end
        task.wait(0.1)
        elapsed += 0.1
    end
    return nil
end

local function matchesSelectedRarity(rarity)
    if #state.nest.selected == 0 then return true end
    return state.nest.selectedSet[rarity] == true
end

local function processNest(model)
    if not state.nest.active or not cachedHrp or not cachedHrp.Parent then return end
    if not model or not model.Parent or state.nest.claimed[model] or not isEgg(model) then return end
    local rarity = getRarity(model)
    if not matchesSelectedRarity(rarity) then return end

    state.nest.claimed[model] = true
    streamAround(model:GetPivot().Position)
    task.wait(0.2)

    local root = model:FindFirstChild("HumanoidRootPart") or waitForRoot(model, 2)
    if not root then state.nest.claimed[model] = nil return end

    local prompts = {}
    for _, child in ipairs(root:GetChildren()) do
        if child:IsA("ProximityPrompt") then prompts[#prompts + 1] = child end
    end
    if #prompts == 0 then state.nest.claimed[model] = nil return end

    cachedHrp.CFrame = root.CFrame
    cachedHrp.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.15)

    for _, prompt in ipairs(prompts) do
        pcall(function()
            prompt.Enabled = true
            prompt.HoldDuration = 0
        end)
        if type(fireproximityprompt) == "function" then
            for _ = 1, 3 do
                pcall(fireproximityprompt, prompt)
                task.wait(0.06)
            end
        end
    end
    cachedHrp.CFrame = CFrame.new(14, -23, -331)
    task.wait(0.12)
end

local function runNestQueue()
    if state.nest.running or not state.nest.active then return end
    state.nest.running = true
    task.spawn(function()
        while #state.nest.queue > 0 and state.nest.active do
            if not cachedHrp or not cachedHrp.Parent then task.wait(0.25)
            else processNest(table.remove(state.nest.queue, 1)) end
        end
        state.nest.running = false
    end)
end

local function enqueueNest(model)
    if not state.nest.active or not model or state.nest.claimed[model] or state.nest.queueSet[model] then return end
    if not isEgg(model) then return end
    if not matchesSelectedRarity(getRarity(model)) then return end
    state.nest.queueSet[model] = true
    state.nest.queue[#state.nest.queue + 1] = model
    runNestQueue()
end

local function watchNest(model)
    if state.nest.watched[model] or not model:IsA("Model") then return end
    state.nest.watched[model] = true
    model:GetAttributeChangedSignal("EggUid"):Connect(function()
        state.nest.claimed[model] = nil
        if state.nest.active then enqueueNest(model) end
    end)
    model:GetAttributeChangedSignal("Egg"):Connect(function()
        state.nest.claimed[model] = nil
        if state.nest.active and model:GetAttribute("Egg") == true then enqueueNest(model) end
    end)
    model.AncestryChanged:Connect(function(_, parent)
        if not parent then
            state.nest.claimed[model] = nil
            state.nest.watched[model] = nil
            state.nest.queueSet[model] = nil
        end
    end)
end

local function scanNests()
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("Model") and isEgg(d) then
            watchNest(d)
            if state.nest.active then enqueueNest(d) end
        end
    end
end

local function collectRarities()
