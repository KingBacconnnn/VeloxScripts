    Desc = "Shows your current Daily Reward status.",
    Icon = "info",
    Color = "Blue",
    Buttons = {},
})

ProgressTab:Toggle({
    Title = "Auto Claim Daily Reward",
    Desc = "Automatically claim your Daily Reward as soon as the cooldown ends.",
    Icon = "gift",
    Type = "Checkbox",
    Value = false,
    Callback = function(value)
        state.daily.autoClaim = value == true
        if state.daily.autoClaim then requestDaily() end
        notify(
            state.daily.autoClaim and "Daily Auto Claim Enabled" or "Daily Auto Claim Disabled",
            state.daily.autoClaim and "Claiming when available" or "Stopped claiming Daily",
            state.daily.autoClaim and "play" or "pause"
        )
    end,
})

ProgressTab:Button({
    Title = "Refresh Daily Status",
    Desc = "Refresh your current Daily Reward status.",
    Icon = "refresh-cw",
    Justify = "Center",
    Callback = function()
        requestDaily()
        task.wait(0.4)
        if state.daily.currentDay then
            local left = dailySecondsLeft()
            DailyStatus:SetDesc(
                left == 0 and ("Day %d ready to claim now"):format(state.daily.currentDay)
                or ("Day %d ready in %s"):format(state.daily.currentDay, formatTime(left))
            )
        else
            DailyStatus:SetDesc("No data yet, try again")
        end
    end,
})

ProgressTab:Button({
    Title = "Claim Daily Now",
    Desc = "Attempt to claim your Daily Reward immediately.",
    Icon = "hand-coins",
    Justify = "Center",
    Callback = function()
        if state.daily.currentDay == nil then
            notify("Not Ready", "No daily data yet", "alert-triangle", 3)
            return
        end
        if not dailyReady() then
            notify("Not Ready", ("Available in %s"):format(formatTime(dailySecondsLeft())), "clock", 3)
            return
        end
        state.daily.lastAttempt = 0
        task.spawn(function()
            local oldAuto = state.daily.autoClaim
            state.daily.autoClaim = true
            tryClaimDaily()
            state.daily.autoClaim = oldAuto
        end)
    end,
})

