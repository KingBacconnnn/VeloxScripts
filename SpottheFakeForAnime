local TierPicker
TierPicker = MainTab:Dropdown({
    Title = "Cursed Tiers",
    Desc = "Mark which Egg tiers to haunt, or leave empty to harvest every cursed tier.",
    Values = discoverTiers(),
    Value = {},
    Multi = true,
    AllowNone = true,
    Callback = function(picked)
        state.selected = picked or {}
        table.clear(state.selectedSet)
        for _, tier in ipairs(state.selected) do
            state.selectedSet[tier] = true
        end
        if state.active then
            table.clear(state.queue)
            table.clear(state.queueSet)
            scanAll()
        end
    end,
})

MainTab:Button({
    Title = "Scan Existing Rarities",
    Desc = "Scan the Halloween world and report which Egg rarities are currently spawned.",
    Icon = "scan-search",
    Justify = "Center",
    Callback = function()
        local result = scanRarities()
