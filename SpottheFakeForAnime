})

local scanAccumulator = 0
RunService.Heartbeat:Connect(function(dt)
    if not state.active then return end
    scanAccumulator += dt
    if scanAccumulator < SCAN_INTERVAL then return end
    scanAccumulator = 0
    if isHalloweenWorldPresent() then
        scanAll()
    end
end)

local function attachRuntime(runtime)
    if not runtime then return end
    if runtime:GetAttribute("HauntedWatcherAttached") then return end
    runtime:SetAttribute("HauntedWatcherAttached", true)

    runtime.DescendantAdded:Connect(function(d)
        if d:IsA("Model") then
            watchNPC(d)
            if state.active then
                task.delay(0.15, function()
                    if d.Parent then enqueue(d) end
                end)
            end
        elseif d:IsA("ProximityPrompt") and d.Parent and d.Parent.Name == "HumanoidRootPart" then
            local model = d.Parent.Parent
            if model and model:IsA("Model") then
                watchNPC(model)
                if state.active then
                    task.delay(0.15, function()
                        if model.Parent then enqueue(model) end
                    end)
                end
            end
        end
    end)
end

local rt = resolveRuntime()
if rt then
    attachRuntime(rt)
end

workspace.ChildAdded:Connect(function(child)
    if child.Name ~= WORLD_NAME then return end
    task.wait(0.5)
    local newRt = resolveRuntime()
    if newRt then
        attachRuntime(newRt)
    end
    if state.active then
        scanAll()
    end
end)

task.spawn(function()
    while task.wait(2) do
        if isHalloweenWorldPresent() then
            local r = resolveRuntime()
            if r then attachRuntime(r) end
        end
    end
end)

if isHalloweenWorldPresent() then
    scanAll()
