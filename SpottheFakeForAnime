local function fireBaseOnce()
    local bases = getBases()
    if #bases == 0 then return false end
    local fired = false
    for _, base in ipairs(bases) do fired = safeFire(baseRemote, base) or fired end
    return fired
end

local function fireBaseWithCheck()
    local bases = getBases()
    if #bases == 0 then return end
    local changed = false
    local connections = {}
    local function watch(inst)
        connections[#connections + 1] = inst.AttributeChanged:Connect(function() changed = true end)
        connections[#connections + 1] = inst.DescendantAdded:Connect(function() changed = true end)
        connections[#connections + 1] = inst.DescendantRemoving:Connect(function() changed = true end)
    end
    for _, base in ipairs(bases) do watch(base) end
    connections[#connections + 1] = player.AttributeChanged:Connect(function() changed = true end)
    for _, base in ipairs(bases) do safeFire(baseRemote, base) end
    task.delay(0.8, function()
        for _, connection in ipairs(connections) do connection:Disconnect() end
        if changed then
            state.base.fails = 0
        else
            state.base.fails += 1
            if state.base.fails >= 3 then
                state.base.backoff = os.clock() + 15
                state.base.fails = 0
                notify("Base Upgrade Paused", "No upgrade detected, retrying in 15s", "clock", 3)
            end
        end
    end)
end

