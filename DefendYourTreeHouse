local leverToggle, crateToggle
local lockUpdating = false

local function applyCrateLeverLock(active)
    if lockUpdating then return end
    lockUpdating = true
    if active == "lever" then
        if crateToggle then crateToggle:Lock() end
        if leverToggle then leverToggle:Unlock() end
    elseif active == "crate" then
        if leverToggle then leverToggle:Lock() end
        if crateToggle then crateToggle:Unlock() end
    else
        if leverToggle then leverToggle:Unlock() end
        if crateToggle then crateToggle:Unlock() end
    end
    lockUpdating = false
end

