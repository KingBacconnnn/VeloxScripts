                        end
                    end
                    task.wait(openCrateDelay)
                end
            end)
        elseif not state then
            openCrateRunning = false
            applyCrateLeverLock(nil)
            task.wait(0.1)
            if crateSavedPos then
                restorePos(crateSavedPos)
                crateSavedPos = nil
            end
        end
    end,
})

