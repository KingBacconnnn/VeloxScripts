local openCrateRunning = false
local openCrateDelay = 1
local crateSavedPos = nil

local function getChestSlots()
    local plot = getMyPlot()
    if not plot then return nil end
    local extras = plot:FindFirstChild("PlotExtras")
    return extras and extras:FindFirstChild("ChestSlots")
end

local function isCrateReady(crate)
    local placedAt = crate:GetAttribute("PlacedAt")
    local duration = crate:GetAttribute("TimerDuration")
    if not placedAt or not duration then return false end
    return (os.time() - tonumber(placedAt)) >= tonumber(duration)
end

local function getMyCrates()
    local list = {}
    local slots = getChestSlots()
    if not slots then return list end
    for i = 2, 4 do
        local slot = slots:FindFirstChild("Slot" .. tostring(i))
        if slot then
            for _, child in ipairs(slot:GetChildren()) do
                if child:IsA("Model") and child:GetAttribute("CrateType") then
                    table.insert(list, { Crate = child, Ready = isCrateReady(child) })
                    break
                end
            end
        end
    end
    return list
end

local function openCrate(crate)
    if not crate or not crate.Parent then return end
    if not isCrateReady(crate) then return end
    local part = crate.PrimaryPart or crate:FindFirstChildWhichIsA("BasePart")
    if not part then return end
    local prompt = part:FindFirstChildWhichIsA("ProximityPrompt")
    if not prompt or not prompt.Enabled then return end
    local saved = savePos()
    if not tryTeleportCFrame(CFrame.new(part.Position + Vector3.new(0, 0, -4))) then return end
    task.wait(0.3)
    for i = 1, 3 do
        if not openCrateRunning then break end
        if not crate.Parent or not prompt.Enabled then break end
        pcall(function() fireproximityprompt(prompt) end)
        if i < 3 then task.wait(0.15) end
    end
    task.wait(0.3)
    restorePos(saved)
end

