local lockRunning = false
local hitRunning = false
local currentTarget = nil
local targetConn = nil
local standDistance = 3
local heightOffset = 1
local combatSavedPos = nil

local function getEnemyRoot(enemy)
    return enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart
end

local function isInMyPlot(enemy)
    local ownerPlot = enemy:FindFirstChild("OwnerPlot")
    if not ownerPlot or not ownerPlot:IsA("ObjectValue") then return false end
    local plotValue = ownerPlot.Value
    if not plotValue then return false end
    return plotValue:GetAttribute("OwnerId") == LocalPlayer.UserId
end

local function isAlive(enemy)
    local health = enemy:GetAttribute("Health")
    if health ~= nil and health <= 0 then return false end
    local hum = enemy:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return false end
    return true
end

local function isValidTarget(enemyRoot)
    if not enemyRoot or not enemyRoot.Parent then return false end
    if enemyRoot.Position.Y < -50 then return false end
    local model = enemyRoot.Parent
    if not isAlive(model) then return false end
    if not isInMyPlot(model) then return false end
    return true
end

local function getNearestPlotEnemy()
    local root = getRoot()
    if not root then return nil end
    local best, bestDist
    for _, enemy in ipairs(CollectionService:GetTagged("Enemy")) do
        if enemy:IsA("Model") and enemy.Parent and isInMyPlot(enemy) and isAlive(enemy) then
            local enemyRoot = getEnemyRoot(enemy)
            if enemyRoot and enemyRoot.Parent and enemyRoot.Position.Y >= -50 then
                local dist = (enemyRoot.Position - root.Position).Magnitude
                if not bestDist or dist < bestDist then
                    best = enemyRoot
                    bestDist = dist
                end
            end
        end
    end
    return best
end

local function beginFollow()
    if targetConn then targetConn:Disconnect() end
    targetConn = RunService.Heartbeat:Connect(function()
        if not lockRunning then return end
        if not isValidTarget(currentTarget) then
            currentTarget = getNearestPlotEnemy()
            if not currentTarget then return end
        end
        local root = getRoot()
        if not root then return end
        local enemyPos = currentTarget.Position
        local enemyLook = currentTarget.CFrame.LookVector
        local standPos = enemyPos + enemyLook * standDistance + Vector3.new(0, heightOffset, 0)
        local dt = os.clock() - lastTeleportTime
        if dt >= TELEPORT_COOLDOWN then
            lastTeleportTime = os.clock()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = CFrame.new(standPos, enemyPos)
        end
    end)
end

local function getSword()
    local char = LocalPlayer.Character
    if not char then return nil end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") and child:HasTag("Sword") then
            return child
        end
    end
    return nil
end

local function hitOnce()
    local sword = getSword()
    if not sword then return false end
    pcall(function() SwordHitEvent:FireServer(sword) end)
    return true
end

