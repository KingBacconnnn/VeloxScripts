local dailyRunning = false
local dailyDelay = 5
local dailyState = { Claimable = false, NextDay = 1, Cooldown = 0 }

local function refreshDailyState()
    local ok, claimable, nextDay, _, cooldown = pcall(function()
        return FetchDailyRewards:InvokeServer()
    end)
    if not ok then return false end
    dailyState.Claimable = claimable == true
    dailyState.NextDay = tonumber(nextDay) or dailyState.NextDay
    dailyState.Cooldown = tonumber(cooldown) or 0
    return true
end

local function tryClaimDaily()
    if not dailyState.Claimable then return false end
    local ok, result = pcall(function() return ClaimDailyReward:InvokeServer() end)
    if ok and result == true then
        dailyState.Claimable = false
        return true
    end
    return false
end

local function runDailyCycle()
    refreshDailyState()
    if dailyState.Claimable then
        return tryClaimDaily()
    end
    return false
end

