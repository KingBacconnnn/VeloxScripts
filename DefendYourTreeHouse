local buyCrateRunning = false
local buyCrateDelay = 1
local selectedCrates = {}
local Stocks = {}

local function hasEmptyCrateSlot()
    local plot = getMyPlot()
    if not plot then return false end
    local extras = plot:FindFirstChild("PlotExtras")
    local chestSlots = extras and extras:FindFirstChild("ChestSlots")
    if not chestSlots then return false end
    for i = 2, 4 do
        local slot = chestSlots:FindFirstChild("Slot" .. tostring(i))
        if slot then
            local hasModel = false
            for _, child in ipairs(slot:GetChildren()) do
                if child:IsA("Model") then
                    hasModel = true
                    break
                end
            end
            if not hasModel then return true end
        end
    end
    return false
end

local function getCrateNames()
    local names = {}
    for name in pairs(CrateConfigurations) do
        if type(CrateConfigurations[name]) == "table" then
            table.insert(names, name)
        end
    end
    table.sort(names, function(a, b)
        return (CrateConfigurations[a].Price or 0) < (CrateConfigurations[b].Price or 0)
    end)
    return names
end

local function refreshStocks()
    local ok, result = pcall(function() return GetCrateShopStocks:InvokeServer() end)
    if ok and type(result) == "table" then
        Stocks = result
    end
end

local function tryBuyCrate(crateType)
    local config = CrateConfigurations[crateType]
    if not config then return false end
    if (tonumber(Stocks[crateType]) or 0) <= 0 then return false end
    if getCash() < (tonumber(config.Price) or 0) then return false end
    if not hasEmptyCrateSlot() then return false end
    pcall(function() PurchaseCrate:FireServer(crateType) end)
    return true
end

local function buyAllSelected()
    for _, crateType in ipairs(getCrateNames()) do
        if selectedCrates[crateType] then
            if tryBuyCrate(crateType) then
                task.wait(0.3)
            end
        end
    end
end

UpdateCrateStocks.OnClientEvent:Connect(function(newStocks)
    if type(newStocks) == "table" then
        Stocks = newStocks
    end
end)

task.spawn(function()
    task.wait(1)
    refreshStocks()
end)

