local TELEPORT_COOLDOWN = 0.35
local lastTeleportTime = 0

local function getRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart") or nil
end

local function savePos()
    local root = getRoot()
    return root and root.CFrame or nil
end

local function restorePos(cframe)
    if not cframe then return end
    local root = getRoot()
    if root then
        root.CFrame = cframe
    end
    lastTeleportTime = os.clock()
end

local function waitForTeleportSlot(timeout)
    local start = os.clock()
    while os.clock() - lastTeleportTime < TELEPORT_COOLDOWN do
        if os.clock() - start > (timeout or 1) then
            return false
        end
        task.wait(0.03)
    end
    return true
end

local function tryTeleportCFrame(cframe)
    if not waitForTeleportSlot(0.5) then return false end
    local root = getRoot()
    if not root then return false end
    lastTeleportTime = os.clock()
    root.CFrame = cframe
    return true
end

local function getCash()
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    local cash = stats and stats:FindFirstChild("Cash")
