local teleportWait = 0.5
local promptAttempts = 3
local labelWait = 1
local selectedRarities = {}
local attemptedAnchors = {}

local RarityList = {
    "Common", "Uncommon", "Rare", "Epic", "Legendary",
    "Mythic", "Mythical", "Divine", "Eternal", "Celestial",
    "Secret", "Exclusive", "Godly", "Ethereal", "Cosmic", "Exotic",
}

local PriceMultipliers = {
    [""] = 1,
    K = 1e3, M = 1e6, B = 1e9, T = 1e12, Q = 1e15,
    k = 1e3, m = 1e6, b = 1e9, t = 1e12, q = 1e15,
}

local function normalize(text)
    if type(text) ~= "string" then return "" end
    return text:lower():gsub("^%s+", ""):gsub("%s+$", "")
end

local function getLeverPrompt()
    local plot = getMyPlot()
    if not plot then return nil end
    local extras = plot:FindFirstChild("PlotExtras") or plot:WaitForChild("PlotExtras", 2)
    local randomizer = extras and (extras:FindFirstChild("Randomizer") or extras:WaitForChild("Randomizer", 2))
    local roll = randomizer and (randomizer:FindFirstChild("Roll") or randomizer:WaitForChild("Roll", 2))
    local lever = roll and (roll:FindFirstChild("Lever") or roll:WaitForChild("Lever", 2))
    local knob = lever and (lever:FindFirstChild("Knob") or lever:WaitForChild("Knob", 2))
    return knob and knob:FindFirstChild("SlotPrompt", true)
end

local function pullLever()
    local prompt = getLeverPrompt()
    if not prompt or not prompt.Enabled then return end
    pcall(function() fireproximityprompt(prompt) end)
end

local function cleanupAttempted()
    for anchor in pairs(attemptedAnchors) do
        if not anchor.Parent then
            attemptedAnchors[anchor] = nil
        end
    end
end

local function findFreshAnchor()
    cleanupAttempted()
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("BasePart") and child.Name == "PromptAnchor" and not attemptedAnchors[child] then
            local prompt = child:FindFirstChild("PickupPrompt")
            if prompt and prompt:IsA("ProximityPrompt") then
                return child, prompt
            end
        end
    end
    return nil, nil
end

local function getSortedLabels(anchor)
    local gui = anchor and anchor:FindFirstChild("RarityGui")
    local frame = gui and gui:FindFirstChild("Frame")
    if not frame then return {} end
    local labels = {}
    for _, child in ipairs(frame:GetChildren()) do
        if child:IsA("TextLabel") then
            table.insert(labels, child)
        end
    end
    table.sort(labels, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
    return labels
end

local function getRarity(anchor)
    local labels = getSortedLabels(anchor)
    if #labels == 0 then return nil end
    local known = {}
    for _, r in ipairs(RarityList) do
        known[normalize(r)] = r
    end
    for _, label in ipairs(labels) do
        local t = normalize(label.Text)
        if known[t] then return known[t] end
    end
    return nil
end

local function parsePrice(text)
    if type(text) ~= "string" or not text:find("%$") then return nil end
    local cleaned = text:gsub("[%$%s,]", "")
    local num, suffix = cleaned:match("^([%d%.]+)([KMBTQkmbtq]?)$")
    if not num then return nil end
    local value = tonumber(num)
    if not value then return nil end
    return value * (PriceMultipliers[suffix] or 1)
end

local function getPrice(anchor)
    for _, label in ipairs(getSortedLabels(anchor)) do
        local price = parsePrice(label.Text)
        if price then return price end
    end
    return nil
end

local function rarityMatches(rarity)
    if not next(selectedRarities) then return true end
    if not rarity then return false end
    local n = normalize(rarity)
    for key in pairs(selectedRarities) do
        if normalize(key) == n then return true end
    end
    return false
end

local function canAfford(anchor)
    local price = getPrice(anchor)
    if not price then return false end
    return getCash() >= price
end

local function waitForRarity(anchor, timeout)
    local start = os.clock()
    while leverRunning and os.clock() - start < timeout do
        if not anchor.Parent then return nil end
        local rarity = getRarity(anchor)
        if rarity then return rarity end
        task.wait(0.05)
    end
    return nil
end

local function teleportToPickup(anchor, prompt)
    local saved = savePos()
    if not tryTeleportCFrame(CFrame.new(anchor.Position)) then return end
    task.wait(teleportWait)
    for i = 1, promptAttempts do
        if not leverRunning then break end
        if not anchor.Parent or not prompt.Parent or not prompt.Enabled then break end
        pcall(function() fireproximityprompt(prompt) end)
        if i < promptAttempts then
            task.wait(0.15)
        end
    end
    local vanishStart = os.clock()
    while leverRunning and anchor.Parent and os.clock() - vanishStart < 2 do
        task.wait(0.1)
    end
    restorePos(saved)
end

