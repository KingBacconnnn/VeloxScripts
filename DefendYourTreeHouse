local function getMyTurrets()
    local plot = getMyPlot()
    if not plot then return {} end
    local list = {}
    for _, child in ipairs(plot:GetDescendants()) do
        if child:IsA("Model") and CollectionService:HasTag(child, "Turret") then
            table.insert(list, child)
        end
    end
    return list
end

local function getTurretCost(turret, amount)
    local config = ItemConfigurations[turret.Name]
    if not config then return math.huge end
    local basePrice = config.Price or 100
    local level = tonumber(turret:GetAttribute("Level")) or 1
    local total = 0
    for i = 0, amount - 1 do
        total = total + math.floor((basePrice / 2) * (1.1 ^ (level + i - 1)))
    end
    return total
end

local function tryUpgradeTurret(turret)
    local maxLevel = UpgradeConfigurations.MaxTurretLevel
    local level = tonumber(turret:GetAttribute("Level")) or 1
    if level >= maxLevel then return end
    local amount = Use5x and math.min(5, maxLevel - level) or 1
    if getCash() < getTurretCost(turret, amount) then return end
    if UseLock then
        local saved = savePos()
        local part = turret.PrimaryPart or turret:FindFirstChildWhichIsA("BasePart")
        if part then
            tryTeleportCFrame(CFrame.new(part.Position + Vector3.new(0, 3, 0)))
            task.wait(0.2)
        end
        UpgradeTurretRemote:FireServer(turret, amount)
        task.wait(0.15)
        restorePos(saved)
    else
        UpgradeTurretRemote:FireServer(turret, amount)
    end
end

local function tryUpgradeRolls()
