local indexRunning = false
local indexDelay = 1
local indexData = nil

local function getMilestones()
    return IndexConfig.Milestones or {}
end

local function isIndexClaimed(id)
    if not indexData or not indexData.Claimed then return false end
    return indexData.Claimed[id] == true
end

local function isIndexComplete(milestone)
    if not indexData then return false end
    local ok, result = pcall(function() return IndexConfig.IsComplete(milestone, indexData) end)
    return ok and result == true
end

local function refreshIndexData()
    if not GetIndexData then return end
    local ok, data = pcall(function() return GetIndexData:InvokeServer() end)
    if ok and type(data) == "table" then
        indexData = data
    end
end

local function getClaimableMilestones()
    local list = {}
    if not indexData then return list end
    for _, milestone in ipairs(getMilestones()) do
        if milestone.Id and not isIndexClaimed(milestone.Id) and isIndexComplete(milestone) then
            table.insert(list, milestone)
        end
    end
    return list
end

local function claimMilestone(id)
    local ok, _, _, data = pcall(function() return ClaimIndexReward:InvokeServer(id) end)
    if ok and type(data) == "table" then
        indexData = data
    end
end

local function claimAllMilestones()
    if not indexData then refreshIndexData() end
    if not indexData then return end
    for _, milestone in ipairs(getClaimableMilestones()) do
        claimMilestone(milestone.Id)
        task.wait(0.1)
    end
end

