local function refreshInventories()
    pcall(function() turretInventory = table.clone(PlacementHandler:GetInventory()) end)
    local ok, weapons, equipped = pcall(function() return GetWeaponsInventory:InvokeServer() end)
    if ok and type(weapons) == "table" then
        weaponInventory = table.clone(weapons)
        if type(equipped) == "string" then
            equippedWeapon = equipped
        end
    end
end

local function getSellPrice(category, id)
    if category == "Turrets" then
        return SellConfigurations.getTurretPrice(id)
    end
    return SellConfigurations.getWeaponPrice(id)
end

local function getSellableNames(category)
    local list = {}
    local source = category == "Turrets" and turretInventory or weaponInventory
    for id, count in pairs(source) do
        local n = tonumber(count) or 0
        if category == "Weapons" and keepEquipped and id == equippedWeapon then
            n = n - 1
        end
        if n > 0 and getSellPrice(category, id) then
            table.insert(list, id)
        end
    end
    table.sort(list, function(a, b)
        return (getSellPrice(category, a) or 0) < (getSellPrice(category, b) or 0)
    end)
    return list
end

local function sellOne(category, id, amount)
    if not id or not amount or amount <= 0 then return false end
    local ok, result = pcall(function() return SellItem:InvokeServer(category, id, amount) end)
    if ok and type(result) == "table" and result.Success then
        if type(result.Inventory) == "table" then
            if category == "Turrets" then
                turretInventory = table.clone(result.Inventory)
            else
                weaponInventory = table.clone(result.Inventory)
            end
        end
        if type(result.Equipped) == "string" then
            equippedWeapon = result.Equipped
        end
        return true
    end
    return false
end

local function sellCategory(category)
    local ok, result = pcall(function() return SellAll:InvokeServer(category) end)
    if ok and type(result) == "table" and result.Success then
        refreshInventories()
        return true
    end
    return false
end

local function sellSelected()
    if sellTurrets then
        for _, id in ipairs(getSellableNames("Turrets")) do
            if selectedItems.Turrets[id] then
                local count = tonumber(turretInventory[id]) or 0
                if count > 0 then
                    sellOne("Turrets", id, count)
                    task.wait(0.15)
                end
            end
        end
    end
    if sellWeapons then
        for _, id in ipairs(getSellableNames("Weapons")) do
            if selectedItems.Weapons[id] then
                local count = tonumber(weaponInventory[id]) or 0
                if keepEquipped and id == equippedWeapon then
                    count = count - 1
                end
                if count > 0 then
                    sellOne("Weapons", id, count)
                    task.wait(0.15)
                end
            end
        end
    end
end

