local dragging = false
local dragStart
local dragStartX = 0
local dragStartY = 0
local dragInput

connect(DragArea.InputBegan, function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	dragging = true
	dragInput = input
	dragStart = input.Position

	local position = Root.Position
	dragStartX = position.X.Offset
	dragStartY = position.Y.Offset
end)

connect(UserInputService.InputChanged, function(input)
	if not dragging then
		return
	end

	if dragInput.UserInputType == Enum.UserInputType.Touch then
		if input ~= dragInput then
			return
		end
	elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
		return
	end

	local delta = input.Position - dragStart

	Root.Position = UDim2.fromOffset(
		dragStartX + delta.X,
		dragStartY + delta.Y
	)
end)

connect(UserInputService.InputEnded, function(input)
	if input == dragInput then
		dragging = false
		dragInput = nil
	end
end)

local function setMinimized(state)
	if CleaningUp then
		return
	end

	Minimized = state

	Title.Visible = not state
	Author.Visible = not state
	StatusDot.Visible = not state

	StatsContainer.Visible = not state
	Footer.Visible = not state

	MiniIndicator.Visible = state
	MiniFPS.Visible = state
	MiniPing.Visible = state
	MiniTime.Visible = state

	MinimizeButton.Text = state and "+" or "−"

	TweenService:Create(
		Root,
		TweenInfo.new(
			0.26,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out
		),
		{
			Size = UDim2.fromOffset(
				PANEL_WIDTH,
				state and MINIMIZED_HEIGHT or EXPANDED_HEIGHT
			)
		}
	):Play()
end

connect(MinimizeButton.Activated, function()
	setMinimized(not Minimized)
end)

local SessionStart = os.clock()
local FrameCount = 0
local FPSElapsed = 0
local UIElapsed = 0
local PulseTime = 0

local function formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))

	local hours = math.floor(seconds / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	local secs = seconds % 60

	return string.format("%02d:%02d:%02d", hours, minutes, secs)
end

local function getPing()
	local ping

	pcall(function()
		local network = Stats:FindFirstChild("Network")
		local serverStats = network and network:FindFirstChild("ServerStatsItem")
		local dataPing = serverStats and serverStats:FindFirstChild("Data Ping")

		if dataPing then
			ping = dataPing:GetValue()
		end
	end)

	if typeof(ping) ~= "number" then
		pcall(function()
			local performanceStats = Stats:FindFirstChild("PerformanceStats")
			local pingObject = performanceStats and performanceStats:FindFirstChild("Ping")

			if pingObject then
				ping = pingObject:GetValue()
			end
		end)
	end

	return typeof(ping) == "number" and math.floor(ping) or nil
end

connect(LocalPlayer.Idled, function()
	if not GENV.OveiAntiAFKActive or CleaningUp then
		return
	end

	pcall(function()
		VirtualUser:CaptureController()
		VirtualUser:ClickButton2(Vector2.new())
	end)
end)

connect(RunService.RenderStepped, function(deltaTime)
	if not GENV.OveiAntiAFKActive or CleaningUp then
		return
	end

	PulseTime += deltaTime * 2

	local transparency =
		0.08 + ((math.sin(PulseTime) + 1) * 0.08)

	StatusDot.BackgroundTransparency = transparency
	MiniIndicator.BackgroundTransparency = transparency
end)

connect(RunService.Heartbeat, function(deltaTime)
	if not GENV.OveiAntiAFKActive or CleaningUp then
		return
	end

	FrameCount += 1
	FPSElapsed += deltaTime
	UIElapsed += deltaTime

	if FPSElapsed >= 1 then
		local fps = math.floor((FrameCount / FPSElapsed) + 0.5)
		local fpsText = tostring(fps)

		FPSLabel.Text = fpsText
		MiniFPSText.Text = "FPS " .. fpsText

		local ping = getPing()

		if ping then
			PingLabel.Text = tostring(ping) .. " ms"
			MiniPingText.Text = "PING " .. tostring(ping)
		else
			PingLabel.Text = "--"
			MiniPingText.Text = "PING --"
		end

		FrameCount = 0
		FPSElapsed = 0
	end

	if UIElapsed >= 0.25 then
		local sessionText = formatTime(os.clock() - SessionStart)

		TimeLabel.Text = sessionText
		MiniTimeText.Text = sessionText

		UIElapsed = 0
	end
end)

local function cleanup()
	if CleaningUp then
		return
	end

	CleaningUp = true
	GENV.OveiAntiAFKActive = false

	if GENV.OveiAntiAFKCleanup == cleanup then
		GENV.OveiAntiAFKCleanup = nil
	end

	dragging = false
	dragInput = nil

	for i = #Connections, 1, -1 do
		pcall(function()
			Connections[i]:Disconnect()
		end)

		Connections[i] = nil
	end

	pcall(function()
		ScreenGui:Destroy()
	end)
end

GENV.OveiAntiAFKCleanup = cleanup

connect(CloseButton.Activated, cleanup)

connect(ScreenGui.AncestryChanged, function(_, parent)
	if not parent and not CleaningUp then
		cleanup()
	end
end)

