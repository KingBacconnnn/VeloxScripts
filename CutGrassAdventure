-- ====== Helper functions for cutters ======
local function isCutterWorldUnlocked(name)
    local data = cuttersData[name]
    if not data then return false end
    local requiredWorld = tonumber(data.RequiredWorld) or tonumber(data.World) or 1
    local highestWorld = tonumber(LocalPlayer:GetAttribute("HighestVisitedWorld"))
                     or tonumber(LocalPlayer:GetAttribute("World"))
                     or tonumber(LocalPlayer:GetAttribute("HighestWorld"))
                     or tonumber(LocalPlayer:GetAttribute("CurrentWorld"))
                     or 1
    return highestWorld >= requiredWorld
end

local function getCutterPrice(name)
    local data = cuttersData[name]
    if not data then return math.huge end
    local price = data.Price
    if type(price) == "number" then return price end
    return parseMoneyString(price) or math.huge
end

local function findCheapestAffordableUnownedCutter()
    local bestName, bestPrice = nil, math.huge
    local currentTime = os.clock()
    for name, data in pairs(cuttersData) do
        if not ownedCutters[name] and (not ignoredCutters[name] or ignoredCutters[name] < currentTime) then
            if isCutterWorldUnlocked(name) then
                local price = getCutterPrice(name)
                if price <= money and price < bestPrice then
                    bestName = name
                    bestPrice = price
                end
            end
        end
    end
    return bestName
end

local function findBestOwnedCutter()
    local bestName, bestDamage = nil, -math.huge
    for name, data in pairs(cuttersData) do
        if ownedCutters[name] then
            local dmg = tonumber(data.DamageMult) or tonumber(data.Multiplier) or tonumber(data.Damage) or 0
            if dmg > bestDamage then
                bestDamage = dmg
                bestName = name
            end
        end
    end
    return bestName
end

local function buyOrEquipCutter(name, isEquipping)
    if isBuyingCutter then return end
    isBuyingCutter = true
    if cutterBuyTimeout then task.cancel(cutterBuyTimeout) end
    cutterBuyTimeout = task.delay(5, function()
        isBuyingCutter = false
        cutterBuyTimeout = nil
    end)

    pcall(function()
        local result = CuttersShopService:BuyCutter(name)
        if type(result) == "table" and result.andThen then
            result:andThen(function(success)
                isBuyingCutter = false
                if cutterBuyTimeout then task.cancel(cutterBuyTimeout) cutterBuyTimeout = nil end
                if success == true then
                    refreshCuttersState()
                elseif not isEquipping then
                    ignoredCutters[name] = os.clock() + 30
                end
            end):catch(function()
                isBuyingCutter = false
                if cutterBuyTimeout then task.cancel(cutterBuyTimeout) cutterBuyTimeout = nil end
                if not isEquipping then
                    ignoredCutters[name] = os.clock() + 30
                end
            end)
        else
            isBuyingCutter = false
            if cutterBuyTimeout then task.cancel(cutterBuyTimeout) cutterBuyTimeout = nil end
            if result == true then
                refreshCuttersState()
            elseif result == false and not isEquipping then
                ignoredCutters[name] = os.clock() + 30
            end
        end
    end)
end

-- ====== Aura helper functions (updated) ======
local function isAuraWorldLocked(name)
    local requiredWorld = AurasConfig.RequiredWorldByAuraId and AurasConfig.RequiredWorldByAuraId[name]
    if not requiredWorld then return false end
    -- If owned, it's not locked
    if auraState and auraState.Items and auraState.Items[name] and auraState.Items[name].Owned then
        return false
    end
    local highest = tonumber(LocalPlayer:GetAttribute("HighestVisitedWorld")) or 1
    return highest < math.max(1, tonumber(requiredWorld))
end

local function isAuraOwned(name)
    if not auraState or not auraState.Items then return false end
    local item = auraState.Items[name]
    return item and item.Owned == true
end

local function isAuraEquipped(name)
    if not auraState or not auraState.Items then return false end
    local item = auraState.Items[name]
    return item and item.Equipped == true
end

local function findCheapestAffordableUnownedAura()
    local bestName, bestPrice = nil, math.huge
    local currentTime = os.clock()
    for _, auraName in ipairs(auraNames) do
        local auraData = AurasConfig.Items[auraName]
        if auraData and not isAuraOwned(auraName) and not isAuraWorldLocked(auraName) then
            -- Skip event-only auras for buying
            if not auraData.EventOnly then
                if not ignoredAuras[auraName] or ignoredAuras[auraName] < currentTime then
                    local price = parseMoneyString(auraData.Price) or tonumber(auraData.Price) or 0
                    if price <= money and price < bestPrice then
                        bestName = auraName
                        bestPrice = price
                    end
                end
            end
        end
    end
    return bestName
end

local function findBestOwnedAura()
    local bestName, bestBoost = nil, -math.huge
    for auraName, data in pairs(AurasConfig.Items) do
        if isAuraOwned(auraName) then
            local boost = tonumber(data.StrengthMultiplier) or 0
            if boost > bestBoost then
                bestBoost = boost
                bestName = auraName
            end
        end
    end
    return bestName
end

local function buyOrToggleAura(auraName, isEquipping)
    if isBusyAura then return end
    isBusyAura = true
    pcall(function()
        local res = AuraService:BuyOrToggleAura(auraName)
        if type(res) == "table" and res.andThen then
            res:andThen(function(result)
                isBusyAura = false
                if type(result) == "table" and result.State then
                    updateAuraState(result.State)
                else
                    refreshAuraState()
                end
                -- If buy failed and not equipping, add cooldown
                if not isEquipping and (type(result) ~= "table" or not result.Success) then
                    ignoredAuras[auraName] = os.clock() + 30
                end
            end):catch(function()
                isBusyAura = false
                if not isEquipping then
                    ignoredAuras[auraName] = os.clock() + 30
                end
                refreshAuraState()
            end)
        else
            isBusyAura = false
            if type(res) == "table" and res.State then
                updateAuraState(res.State)
            else
                refreshAuraState()
            end
            if not isEquipping and (type(res) ~= "table" or not res.Success) then
                ignoredAuras[auraName] = os.clock() + 30
            end
        end
    end)
end

