local function getSkillPoints()
    return tonumber(Player:GetAttribute("SkillPoints")) or 0
end

local function getCurrentVersion()
    local v = Player:GetAttribute("Version")
    return (typeof(v) == "number" and v >= 1) and v or 1
end

local function getAILevel()
    local lvl = Player:GetAttribute("AILevel")
    return typeof(lvl) == "number" and lvl or 0
end

local function getRunHacks()
    local h = Player:GetAttribute("RunHacks")
    return tonumber(h) or 0
end

local function getMoney()
    local ls = Player:FindFirstChild("leaderstats")
    local money = ls and ls:FindFirstChild("Money")
    return money and money:IsA("IntValue") and money.Value or 0
end

local function canRebirth()
    local ver = getCurrentVersion()
    local levelReq = SkillMath.rebirthLevelReq(ver)
    local moneyReq = SkillMath.rebirthMoneyCost(ver)
    local hackReq = SkillMath.rebirthHackReq(ver)
    return getAILevel() >= levelReq and getMoney() >= moneyReq and (hackReq <= 0 or getRunHacks() >= hackReq)
end

local function doRebirth()
    if canRebirth() then
        local modelName = Player:GetAttribute("ModelName")
        if typeof(modelName) ~= "string" or modelName == "" then
            modelName = ("%sAI"):format(Player.DisplayName)
        end
        RebirthRemote:FireServer(modelName)
    end
end

local function getOwnPlot()
    local plotId = Player:GetAttribute("PlotId")
    if typeof(plotId) ~= "number" then return nil end

    local plotsFolder = Workspace:FindFirstChild("Map")
        and Workspace.Map:FindFirstChild("Generated")
        and Workspace.Map.Generated:FindFirstChild("Plots")

    if not plotsFolder then return nil end

    for _, plot in ipairs(plotsFolder:GetChildren()) do
        if plot:GetAttribute("PlotId") == plotId then
            return plot
        end
    end
    return nil
end

local function getRoot()
    local character = Player.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

