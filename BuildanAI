local autoSell = false
local sellThread = nil
local savedCFrame = nil

CollectingTab:Toggle({
    Title = "Auto Sell Tokens",
    Desc = "Automatically sells your tokens and returns you to your previous location.",
    Value = false,
    Callback = function(state)
        autoSell = state
        if state then
            local root = getRoot()
            if root then
                savedCFrame = root.CFrame
            end
            if sellThread then return end
            sellThread = task.spawn(function()
                while autoSell do
                    pcall(function()
                        local root = getRoot()
                        if root then
                            root.CFrame = savedCFrame
                        end
                        Warp:FireServer("Sell")
                        task.wait(0.5)
                        SellTokens:FireServer()
                        task.wait(0.5)
                        if savedCFrame then
                            local root = getRoot()
                            if root then
                                root.CFrame = savedCFrame
                            end
                        end
                    end)
                    task.wait(1)
                end
                sellThread = nil
            end)
        end
    end
})

local selectedCrateIds = {}
local autoBuyCrates = false
local buyCratesThread = nil

BlackMarketTab:Dropdown({
    Title = "Crates",
    Desc = "Select which crates to auto buy.",
    Values = crateNames,
    Value = {},
    Multi = true,
    AllowNone = true,
    Callback = function(option)
        selectedCrateIds = {}
        for _, name in ipairs(option) do
            for _, tier in ipairs(crateTiers) do
                if tier.name == name then
                    selectedCrateIds[tier.id] = true
                    break
                end
            end
        end
    end
})

BlackMarketTab:Toggle({
    Title = "Auto Buy Crates",
    Desc = "Automatically buys selected crates when you have enough tokens.",
    Value = false,
    Callback = function(state)
        autoBuyCrates = state
        if state then
            if buyCratesThread then return end
            buyCratesThread = task.spawn(function()
                while autoBuyCrates do
                    pcall(function()
                        local tokens = tonumber(Player:GetAttribute("Tokens")) or 0
                        for _, tier in ipairs(crateTiers) do
                            if not autoBuyCrates then break end
                            if selectedCrateIds[tier.id] then
                                if tokens >= tier.priceTokens then
                                    BlackMarketBuy:InvokeServer("crate", tier.id)
                                    tokens = tokens - tier.priceTokens
                                    task.wait(0.3)
                                end
                            end
                        end
                    end)
                    task.wait(1)
                end
                buyCratesThread = nil
            end)
        end
    end
})

local autoLuck = false
local luckThread = nil

BlackMarketTab:Toggle({
    Title = "Auto Upgrade Dealer Luck",
    Desc = "Automatically buys Dealer Luck upgrades when you have enough tokens.",
    Value = false,
    Callback = function(state)
        autoLuck = state
        if state then
            if luckThread then return end
            luckThread = task.spawn(function()
                while autoLuck do
                    pcall(function()
                        local tokens = tonumber(Player:GetAttribute("Tokens")) or 0
                        local luck = tonumber(Player:GetAttribute("CrateLuck")) or 0
                        local step = math.floor(luck / Config.CrateShop.luck.stepPct)
                        if step < Config.CrateShop.luck.maxSteps then
                            local cost = math.floor(Config.CrateShop.luck.costBase * Config.CrateShop.luck.costGrowth ^ step)
                            if tokens >= cost then
                                BuyCrateLuck:InvokeServer()
                                task.wait(0.3)
                            end
                        end
                    end)
                    task.wait(1)
                end
                luckThread = nil
            end)
        end
    end
})
