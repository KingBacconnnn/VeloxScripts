task.spawn(function()
    while true do
        if autoCollectBrainrot then
            local hrp = getHRP()
            if not hrp then
                task.wait(0.5)
            else
                local selectedList = {}
                for name, _ in pairs(selectedRarities) do
                    if streamCoords[name] then table.insert(selectedList, name) end
                end
                table.sort(selectedList, function(a,b) return rarityPriority[a] < rarityPriority[b] end)

                if #selectedList > 0 then
                    if currentRarityIndex > #selectedList then currentRarityIndex = 1 end
                    local currentRarity = selectedList[currentRarityIndex]
                    hrp.CFrame = streamCoords[currentRarity]
                    task.wait(2)

                    local prompts = {}
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("ProximityPrompt") and obj.Enabled then
                            local action = string.lower(obj.ActionText or "")
                            if action == "pick up" or action == "collect" or action == "take" or action == "claim" or action == "grab" then
                                local rarity = getRarityFromInstance(obj.Parent)
                                if rarity == currentRarity then
                                    table.insert(prompts, obj)
                                end
                            end
                        end
                    end

                    if #prompts > 0 then
                        table.sort(prompts, function(a,b)
                            local posA = getPosition(a.Parent)
                            local posB = getPosition(b.Parent)
                            return (posA - hrp.Position).Magnitude < (posB - hrp.Position).Magnitude
                        end)
                        local prompt = prompts[1]
                        local targetPos = getPosition(prompt.Parent)
                        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0,3,0))
                        task.wait(1)
                        triggerPrompt(prompt)
                        task.wait(0.5)
                    end

                    returnToSavedPos()
                    currentRarityIndex = currentRarityIndex + 1
                end
            end
        end
        task.wait(0.5)
    end
end)
