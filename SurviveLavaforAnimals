        Desc = "Set how often the hub checks for affordable Trails.",
        Step = 0.5,
        Value = { Min = 1, Max = 10, Default = 2 },
        Callback = function(v) buyInterval = v end,
    })

    TrailTab:Slider({
        Title = "Equip Interval",
        Desc = "Set how often the hub checks for a better Trail.",
        Step = 0.5,
        Value = { Min = 1, Max = 10, Default = 3 },
        Callback = function(v) equipInterval = v end,
    })

    TrailTab:Divider()

    TrailTab:Toggle({
        Title = "Auto Buy Trail",
        Desc = "Automatically buys the cheapest Trail you can afford.",
        Icon = "shopping-cart",
        Type = "Checkbox",
        Value = false,
        Callback = function(state)
            buyEnabled = state
            if not state then return end
            task.spawn(function()
                while buyEnabled do
                    if os.clock() - lastBuy >= buyInterval then
                        local id = getNextAffordable()
                        if id then
                            lastBuy = os.clock()
                            pcall(function()
                                ShopRemote:FireServer("tryBuy", "trail", id)
                            end)
                        end
                    end
                    task.wait(0.3)
                end
            end)
        end,
    })

    TrailTab:Toggle({
        Title = "Auto Equip Best Trail",
        Desc = "Automatically equips your owned Trail with the highest Speed.",
        Icon = "star",
        Type = "Checkbox",
        Value = false,
        Callback = function(state)
            equipEnabled = state
            if not state then return end
            task.spawn(function()
                while equipEnabled do
                    if os.clock() - lastEquip >= equipInterval then
                        local best = getBestOwned()
                        if best and getEquipped() ~= best then
                            lastEquip = os.clock()
                            pcall(function()
                                ShopRemote:FireServer("equip", "trail", best)
                            end)
                        end
                    end
                    task.wait(0.3)
                end
            end)
        end,
    })
end
