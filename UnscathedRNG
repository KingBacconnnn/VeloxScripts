-- Battlepass free rewards
local autoClaimBattlepass = false
local battlepassThread = nil

local function getBattlepassLevel()
    return PlayerService:GetStat("battlepassLevel") or 1
end

local function isFreeClaimed(level)
    local claimed = PlayerService:GetStat("claimedBattlepassRewards")
    if type(claimed) ~= "table" then return false end
    local entry = claimed[level]
    if type(entry) ~= "table" then return false end
    return entry.Free == true or entry.free == true or entry[1] == true
end

BattlepassTab:Toggle({
    Title = "Auto Claim Free Rewards",
    Desc = "Automatically claims all available free battlepass rewards.",
    Value = false,
    Callback = function(state)
        autoClaimBattlepass = state
        if state then
            if battlepassThread then return end
            battlepassThread = task.spawn(function()
                while autoClaimBattlepass do
                    pcall(function()
                        local currentLevel = getBattlepassLevel()
                        local maxLevel = BattlepassConfig.GetMaxLevel()
                        for level = 1, math.min(currentLevel, maxLevel) do
                            if not isFreeClaimed(level) then
                                Network.send("claim_battlepass_reward", level, "Free")
                                task.wait(0.2)
                            end
                        end
                    end)
                    task.wait(1)
                end
                battlepassThread = nil
            end)
        end
    end
})

