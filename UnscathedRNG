-- Skill trees
local treeLabels = {}
local treeMap = {}
for treeName, treeData in pairs(SkillTreeConfig.Trees) do
    local label = treeData.Title or treeName
    treeLabels[#treeLabels + 1] = label
    treeMap[label] = treeName
end
table.sort(treeLabels)

local selectedTrees = {}
local autoUpgradeTrees = false
local skillTreeThread = nil

SkillTreeTab:Dropdown({
    Title = "Select Skill Trees",
    Desc = "Select which trees to auto upgrade entirely.",
    Values = treeLabels,
    Value = {},
    Multi = true,
    AllowNone = true,
    Callback = function(option)
        selectedTrees = option
    end
})

SkillTreeTab:Toggle({
    Title = "Auto Upgrade Skill",
    Desc = "Automatically unlocks nodes in your selected skill trees when requirements are met.",
    Value = false,
    Callback = function(state)
        autoUpgradeTrees = state
        if state then
            if skillTreeThread then return end
            skillTreeThread = task.spawn(function()
                while autoUpgradeTrees do
                    pcall(function()
                        local points = PlayerService.Data.skillTreePoints or 0
                        local upgrades = PlayerService.Data.skillTreeUpgrades or {}
                        for _, label in ipairs(selectedTrees) do
                            if not autoUpgradeTrees then break end
                            local treeName = treeMap[label]
                            if treeName then
                                local treeData = SkillTreeConfig.Trees[treeName]
                                local treeUpgrades = upgrades[treeName] or {}
                                local nodes = treeData.Nodes or {}
                                local changed = true
                                while changed and autoUpgradeTrees do
                                    changed = false
                                    for nodeName, node in pairs(nodes) do
                                        if not treeUpgrades[nodeName] then
                                            local canUnlock = true
                                            for _, req in ipairs(node.Requires or {}) do
                                                if not treeUpgrades[req] then
                                                    canUnlock = false
                                                    break
                                                end
                                            end
                                            if canUnlock and points >= (node.Cost or 0) then
                                                Network.send("skill_unlock_upgrade", treeName, nodeName)
                                                points = points - (node.Cost or 0)
                                                treeUpgrades[nodeName] = true
                                                changed = true
                                                task.wait(0.2)
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end)
                    task.wait(1)
                end
                skillTreeThread = nil
            end)
        end
    end
})

-- Auto roll & equip
local autoRoll = false
local isBusy = false
local consecutiveErrors = 0
local MAX_CONSECUTIVE_ERRORS = 5
local runId = 0

local function stopAutoRoll(reason)
    autoRoll = false
    isBusy = false
    runId = runId + 1
    WindUI:Notify({
        Title = "Auto Roll",
        Content = reason or "Stopped",
        Duration = 5,
        Icon = "x"
    })
end

local function getUnresolvedAura()
    return PlayerService:GetStat("unresolvedAura")
end

local function resolveUnresolved(currentRunId, callback)
    local unresolved = getUnresolvedAura()
    if typeof(unresolved) ~= "table" then
        callback(true)
        return
    end
    local function equip()
        RollRequest.Send("resolve_unresolved_aura", nil, function(success, response)
            if not autoRoll or currentRunId ~= runId then return end
            if success and response and response.success then
                callback(true)
            elseif response and response.errorCode == Enums.ErrorCode.INVENTORY_FULL then
                RollRequest.Send("resolve_unresolved_aura", nil, function(replaceSuccess, replaceResponse)
                    if not autoRoll or currentRunId ~= runId then return end
                    callback(replaceSuccess and replaceResponse and replaceResponse.success)
                end, Enums.UnresolvedAuraAction.ReplaceLowest)
            else
                callback(false)
            end
        end, Enums.UnresolvedAuraAction.Equip)
    end
    equip()
end

local function processRollLoop(currentRunId)
    if not autoRoll or isBusy or currentRunId ~= runId then return end
    isBusy = true
    resolveUnresolved(currentRunId, function(resolveSuccess)
        isBusy = false
        if not autoRoll or currentRunId ~= runId then return end
        if resolveSuccess then
            RollRequest.Send("roll_aura", nil, function(rollSuccess, rollResponse)
                if not autoRoll or currentRunId ~= runId then return end
                if rollSuccess and rollResponse and rollResponse.success then
                    consecutiveErrors = 0
                    if rollResponse.resolution == Enums.RollResolution.Unresolved then
                        task.delay(0.5, function()
                            processRollLoop(currentRunId)
                        end)
                    else
                        local waitTime = (rollResponse.spinCooldown or 0.5) + 0.1
                        task.delay(waitTime, function()
                            processRollLoop(currentRunId)
                        end)
                    end
                else
                    consecutiveErrors = consecutiveErrors + 1
                    if consecutiveErrors >= MAX_CONSECUTIVE_ERRORS then
                        stopAutoRoll("Stopped due to repeated errors")
                    else
                        task.delay(1.5, function()
                            processRollLoop(currentRunId)
                        end)
                    end
                end
            end)
        else
            consecutiveErrors = consecutiveErrors + 1
            if consecutiveErrors >= MAX_CONSECUTIVE_ERRORS then
                stopAutoRoll("Stopped due to repeated errors")
            else
                task.delay(1, function()
                    processRollLoop(currentRunId)
                end)
            end
        end
    end)
end

RollTab:Toggle({
    Title = "Auto Roll & Equip",
    Desc = "Automatically rolls auras, equips them, and replaces lowest aura if inventory is full",
    Value = false,
    Callback = function(state)
        autoRoll = state
        if state then
            runId = runId + 1
            consecutiveErrors = 0
            isBusy = false
            processRollLoop(runId)
        else
            runId = runId + 1
            isBusy = false
        end
    end
})
