    Values = rarityOrder,
    Value = { "Basic" },
    Multi = true,
    AllowNone = true,
    Callback = function(choices)
        farmSelected = {}
        for _, choice in ipairs(choices) do farmSelected[choice] = true end
    end
})

farmToggle = EggsTab:Toggle({
    Title = "Auto Farm Eggs",
    Desc = "Automatically farms eggs based on your selected rarity priority.",
    Value = false,
    Callback = function(state)
        farmAuto = state
        if state then
            if farmThread then
                updateEggLocks()
                return
            end
            farmEmpty = 0
            farmProcessed = 0
            farmRecent = {}
            farmSafePos = nil
            farmStartNoclip()
            farmStartAnchor()
            farmThread = task.spawn(farmLoop)
        else
            farmStopAnchor()
            farmStopNoclip()
            farmThread = nil
        end
        updateEggLocks()
    end
})

task.spawn(function()
    local emptyCycles = 0
    while true do
        if hatchAuto then
            local eggs = getMyPlacedEggs()
            local ready = {}
            for _, egg in ipairs(eggs) do
                if egg and egg.Parent and hatchReady(egg) then
                    table.insert(ready, egg)
                end
            end

            if #ready == 0 then
                emptyCycles = emptyCycles + 1
                if #eggs == 0 and emptyCycles >= HATCH_EMPTY_STOP then
                    hatchAuto = false
                    hatchReturn()
                    notify("Auto Hatch Egg", "No more eggs. Returned to saved position.")
                    emptyCycles = 0
                    if hatchToggle then pcall(function() hatchToggle:SetValue(false) end) end
                    updateEggLocks()
                else
                    task.wait(0.5)
                end
            else
                emptyCycles = 0
                for _, egg in ipairs(ready) do
                    if not hatchAuto then break end
                    if egg and egg.Parent then hatchProcess(egg) end
                end
                task.wait(0.2)
            end
        else
            emptyCycles = 0
            task.wait(0.3)
        end
    end
end)

task.spawn(function()
    while true do
        if placeAuto then
            local ok, err = placeOnce()
            if not ok and err == "NoEggsLeft" then
                placeAuto = false
                placeReturn()
                notify("Auto Place Egg", "No eggs left. Returned to saved position.")
                if placeToggle then pcall(function() placeToggle:SetValue(false) end) end
                updateEggLocks()
                task.wait(0.5)
            else
                task.wait(placeInterval)
            end
        else
            task.wait(0.3)
        end
    end
end)

