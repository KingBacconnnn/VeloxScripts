local trailBuyAuto = false
local trailEquipAuto = false
local trailBuyInterval = 1
local trailEquipInterval = 2

local trailState = { Loaded = false, Owned = {}, Equipped = nil }
local trailBuyBusy = {}
local trailEquipBusy = false

local function trailNorm(name)
    if type(name) ~= "string" then return nil end
    local lower = string.lower(name:gsub("%s+", ""))
    for _, rarity in ipairs(TrailConfig.RarityOrder) do
        if string.lower(rarity) == lower then return rarity end
    end
    return nil
end

local function trailApply(newState)
    if type(newState) ~= "table" then return end
    trailState.Loaded = newState.Loaded == true
    trailState.Owned = type(newState.Owned) == "table" and newState.Owned or {}
    trailState.Equipped = trailNorm(newState.Equipped)
end

local function trailRefresh()
    local ok, result = pcall(function() return GetTrailShopState:InvokeServer() end)
    if ok then trailApply(result) end
end

local function trailTryBuy(rarity)
    if trailBuyBusy[rarity] then return end
    if trailState.Owned[rarity] == true then return end
    trailBuyBusy[rarity] = true
    local ok, result = pcall(function() return BuyTrailCash:InvokeServer(rarity) end)
    trailBuyBusy[rarity] = nil
    if ok and type(result) == "table" then trailApply(result) end
end

local function trailTryEquip(rarity)
    if trailEquipBusy then return end
    trailEquipBusy = true
    local ok, result = pcall(function() return ToggleTrailEquip:InvokeServer(rarity) end)
    trailEquipBusy = false
    if ok and type(result) == "table" then trailApply(result) end
end

local function trailBest()
    local bestRarity, bestMult = nil, -1
    for _, rarity in ipairs(TrailConfig.RarityOrder) do
        if trailState.Owned[rarity] == true then
            local mult = tonumber(TrailConfig.Multipliers[rarity]) or 0
            if mult > bestMult then bestMult = mult bestRarity = rarity end
        end
    end
    return bestRarity
end

