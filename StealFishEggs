local EggsTab = Window:Tab({ Title = "Eggs", Icon = "egg" })

local placeToggle, hatchToggle, farmToggle
local hatchOnceBtn, placeOnceBtn

local function safeLock(el)
    if el then pcall(function() el:Lock() end) end
end

local function safeUnlock(el)
    if el then pcall(function() el:Unlock() end) end
end

local function updateEggLocks()
    if hatchAuto or placeAuto then
        safeLock(farmToggle)
    else
        safeUnlock(farmToggle)
    end
    if farmAuto then
        safeLock(hatchToggle)
        safeLock(placeToggle)
        safeLock(hatchOnceBtn)
        safeLock(placeOnceBtn)
    else
        safeUnlock(hatchToggle)
        safeUnlock(placeToggle)
        safeUnlock(hatchOnceBtn)
        safeUnlock(placeOnceBtn)
    end
end

