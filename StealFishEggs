end

local function equipEggTool()
    local hum = getHumanoid()
    if not hum then return nil end
    local tool = getBackpackEggTool()
    if not tool then return nil end
    pcall(function() hum:EquipTool(tool) end)
    return tool
end

local function getOwnPlacementZone()
    local bases = Workspace:FindFirstChild("Bases")
    if not bases then return nil end

    local baseName = LocalPlayer:GetAttribute("BaseName")
    if type(baseName) == "string" and baseName ~= "" then
        local base = bases:FindFirstChild(baseName)
        if base and base:IsA("Model") and tonumber(base:GetAttribute("OwnerUserId")) == LocalPlayer.UserId then
            local zone = base:FindFirstChild("EggPlacementZone", true)
            if zone and zone:IsA("BasePart") then return zone end
        end
    end

    for _, base in ipairs(bases:GetChildren()) do
        if base:IsA("Model") and tonumber(base:GetAttribute("OwnerUserId")) == LocalPlayer.UserId then
            local zone = base:FindFirstChild("EggPlacementZone", true)
            if zone and zone:IsA("BasePart") then return zone end
        end
    end

    return nil
end

local function teleportToZone(zone)
    local hrp = getHRP()
    if not hrp or not zone then return false end
    hrp.CFrame = CFrame.new(zone.Position + Vector3.new(0, 5, 0))
    return true
end

local function placeReturn()
    if placeSavedCFrame then
        local hrp = getHRP()
        if hrp then hrp.CFrame = placeSavedCFrame end
    end
end

local function randomPointInZone(zone)
    local size = zone.Size
    local half = size * 0.5
    local margin = 0.75
    local rx = (math.random() * 2 - 1) * half.X * margin
    local rz = (math.random() * 2 - 1) * half.Z * margin
    return zone.CFrame:PointToWorldSpace(Vector3.new(rx, half.Y, rz))
end

local function hasAnyEggTool()
    return getEquippedEggTool() ~= nil or getBackpackEggTool() ~= nil
end

local function placeOnce()
    local char = LocalPlayer.Character
    if not char then return false, "No character" end
    if not hasAnyEggTool() then return false, "NoEggsLeft" end

    local zone = getOwnPlacementZone()
    if not zone then return false, "No placement zone" end

    teleportToZone(zone)
    task.wait(0.15)

    local tool = getEquippedEggTool()
    if not tool then
        tool = equipEggTool()
        if not tool then return false, "No egg in backpack" end
        task.wait(placeEquipWait)
        tool = getEquippedEggTool()
        if not tool then return false, "Equip failed" end
    end

    local pos = randomPointInZone(zone)
    pcall(function() PlaceEgg:FireServer(pos) end)
    return true
end

local rarityOrder = { "Basic", "Rare", "Epic", "Legendary", "Mythic", "Abyssal", "Astral" }
local rarityPriority = {}
for i, name in ipairs(rarityOrder) do rarityPriority[name] = i end

local farmConfig = {
    BASE_SPEED = 400,
    STOP_DISTANCE = 6,
    RETURN_POSITION = Vector3.new(28, 119, 4),
    MAX_ATTEMPTS = 2,
    POST_HOLD_WAIT = 0.25,
    PROMPT_COOLDOWN = 0.35,
    RECENT_CACHE_TIME = 2,
    BUSY_TIMEOUT = 3,
    DEBOUNCE_NOTIF_TIME = 5,
    IDLE_RESET_EVERY = 25,
    IDLE_RESET_DURATION = 1.5,
    VOID_Y_THRESHOLD = 100,
}

local farmAuto = false
local farmSelected = {}
local farmThread = nil
local farmNoclip = nil
local farmOriginalCollide = {}
local farmBusy = false
local farmLastPrompt = 0
local farmLastNotif = 0
local farmEmpty = 0
local farmProcessed = 0
local farmRecent = {}
local farmAnchor = nil
local farmSafePos = nil

local function farmRnd(min, max) return min + math.random() * (max - min) end

local function farmNotifyOnce(title, content, icon)
    local now = tick()
    if now - farmLastNotif < farmConfig.DEBOUNCE_NOTIF_TIME then return end
    farmLastNotif = now
    notify(title, content, icon)
end

local function farmAlive()
    local hum = getHumanoid()
    return hum and hum.Health > 0
end

local function farmGrounded()
    local hum = getHumanoid()
    if not hum then return true end
    return hum.FloorMaterial ~= Enum.Material.Air
end

local function farmAllEggs()
    local folder = Workspace:FindFirstChild("SpawnedEggs")
    if not folder then return {} end
    local list = {}
    for _, obj in ipairs(folder:GetChildren()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then table.insert(list, obj) end
    end
    return list
end

local function farmPrompt(egg)
    if not egg then return nil end
    for _, desc in ipairs(egg:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Name == "EggPrompt" then return desc end
    end
    return nil
end

local function farmRarity(egg)
    if not egg then return nil end
    local rarity = egg:GetAttribute("Rarity")
    if type(rarity) == "string" and rarity ~= "" then return rarity end
    for _, desc in ipairs(egg:GetDescendants()) do
        local r = desc:GetAttribute("Rarity")
        if type(r) == "string" and r ~= "" then return r end
    end
    return nil
end

local function farmIsBusy(egg) return egg and egg:GetAttribute("PromptBusy") == true end
local function farmIsPlaced(egg) if not egg then return true end return egg:GetAttribute("PlacementSettled") == true end
local function farmIsMine(egg) return egg and tonumber(egg:GetAttribute("OwnerUserId")) == LocalPlayer.UserId end

local function farmIsRecent(egg)
    local t = farmRecent[egg.Name]
    if not t then return false end
    if tick() - t > farmConfig.RECENT_CACHE_TIME then farmRecent[egg.Name] = nil return false end
    return true
end

local function farmMarkRecent(egg)
    if egg then farmRecent[egg.Name] = tick() end
end

local function farmFace(targetPos)
    local hrp = getHRP()
    if not hrp then return end
    local look = Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z)
    if (look - hrp.Position).Magnitude > 0.1 then
        hrp.CFrame = CFrame.lookAt(hrp.Position, look)
    end
end

local function farmStartNoclip()
    if farmNoclip then return end
    farmOriginalCollide = {}
    farmNoclip = RunService.Stepped:Connect(function()
        if not farmAuto then return end
        local char = LocalPlayer.Character
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                if farmOriginalCollide[part] == nil then farmOriginalCollide[part] = part.CanCollide end
                part.CanCollide = false
            end
        end
    end)
end

local function farmStopNoclip()
    if farmNoclip then farmNoclip:Disconnect() farmNoclip = nil end
    for part, value in pairs(farmOriginalCollide) do
        if part and part.Parent then
            pcall(function() part.CanCollide = value end)
        end
    end
    farmOriginalCollide = {}
end

local function farmStartAnchor()
    if farmAnchor then return end
    farmAnchor = RunService.Heartbeat:Connect(function()
        if not farmAuto then return end
        local hrp = getHRP()
        if not hrp then return end
        if hrp.Position.Y < farmConfig.VOID_Y_THRESHOLD then
            if farmSafePos then hrp.CFrame = CFrame.new(farmSafePos)
            else hrp.CFrame = CFrame.new(farmConfig.RETURN_POSITION) end
        else
            if not farmBusy then farmSafePos = hrp.Position end
        end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function farmStopAnchor()
    if farmAnchor then farmAnchor:Disconnect() farmAnchor = nil end
end

local function farmMove(targetPos)
    local root = getHRP()
    if not root then return false end
    local stopDist = farmConfig.STOP_DISTANCE + farmRnd(-1, 1)
    local timeout = tick() + 8
    while tick() < timeout do
        if not farmAlive() then return false end
        local dt = RunService.Heartbeat:Wait()
        if not root or not root.Parent then
            root = getHRP()
            if not root then return false end
        end
        local current = root.Position
        local offset = targetPos - current
        local distance = offset.Magnitude
        if distance <= stopDist then farmSafePos = current return true end
        local speed = farmConfig.BASE_SPEED * farmRnd(0.9, 1.1)
        local movement = math.min(speed * dt, distance)
        local newPos = current + offset.Unit * movement
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = CFrame.new(newPos)
    end
    return false
end

local function farmWaitBusy(egg, timeout)
    local deadline = tick() + (timeout or farmConfig.BUSY_TIMEOUT)
    while farmIsBusy(egg) and tick() < deadline do
        if not egg.Parent then return end
        task.wait(0.05)
    end
end

local function farmAttemptPrompt(egg, prompt)
    if not egg or not egg.Parent then return false end
    if not prompt or not prompt.Parent then return false end

    farmWaitBusy(egg, farmConfig.BUSY_TIMEOUT)
    if not egg.Parent then return true end

    local hrp = getHRP()
    if not hrp then return false end

    local eggPos = getPivot(egg)
    if not eggPos then return false end
    if (hrp.Position - eggPos).Magnitude > (prompt.MaxActivationDistance or 10) + 4 then return false end

    farmFace(eggPos)

    if not prompt.Enabled then
        pcall(function() prompt.Enabled = true end)
        if not prompt.Enabled then return false end
    end

    local hold = tonumber(prompt.HoldDuration) or 0.2
    local began = pcall(function() prompt:InputHoldBegin() end)
    if not began then return false end
    task.wait(hold)
    pcall(function() prompt:InputHoldEnd() end)
    return true
end

local function farmPressWithRetry(egg, prompt)
    local delays = { 0.25, 0.5 }
    for attempt = 1, farmConfig.MAX_ATTEMPTS do
        if not egg.Parent then return true end
        if not farmAlive() then return false end
        if not prompt or not prompt.Parent then return true end

        local waitNeeded = farmConfig.PROMPT_COOLDOWN - (tick() - farmLastPrompt)
        if waitNeeded > 0 then task.wait(waitNeeded) end

        if farmIsBusy(egg) then
            farmWaitBusy(egg, farmConfig.BUSY_TIMEOUT)
            if not egg.Parent then return true end
        end

        local fired = farmAttemptPrompt(egg, prompt)
        farmLastPrompt = tick()

        if fired then
            task.wait(farmConfig.POST_HOLD_WAIT)
            if not egg.Parent then return true end
        end

        if farmIsBusy(egg) then
            farmWaitBusy(egg, farmConfig.BUSY_TIMEOUT)
            if not egg.Parent then return true end
        end

        if attempt < farmConfig.MAX_ATTEMPTS then
            task.wait(delays[attempt] or 0.5)
        end
    end
    return false
end

local function farmProcess(egg, expectedRarity)
    if farmBusy then return end
    farmBusy = true

    pcall(function()
        if not egg or not egg.Parent then return end
        if farmIsRecent(egg) then return end

        local pos = getPivot(egg)
        if not pos then return end

        if not farmMove(pos + Vector3.new(0, 2, 0)) then return end
        if not egg.Parent then return end
        if not farmAlive() then return end

        farmFace(pos)
        if not farmGrounded() then task.wait(0.08) end
        if not egg.Parent then return end

        local rarity = farmRarity(egg)
        if rarity ~= expectedRarity then return end

        local prompt = farmPrompt(egg)
        if prompt then
            farmPressWithRetry(egg, prompt)
            farmMarkRecent(egg)
        end

        farmMove(farmConfig.RETURN_POSITION)
    end)

    farmBusy = false
end

local function farmIdleReset() task.wait(farmConfig.IDLE_RESET_DURATION) end

