local function farmBuildPriority()
    local list = {}
    for _, rarity in ipairs(rarityOrder) do
        if farmSelected[rarity] then table.insert(list, rarity) end
    end
    table.sort(list, function(a, b)
        return (rarityPriority[a] or 0) > (rarityPriority[b] or 0)
    end)
    return list
end

local function farmLoop()
    while farmAuto do
        if not farmAlive() then
            task.wait(0.3)
        else
            local priority = farmBuildPriority()
            if #priority == 0 then
                farmNotifyOnce("Egg Farm", "No target rarities selected.", "x")
                task.wait(1)
            else
                local eggs = farmAllEggs()
                local chosenRarity, chosenEgg = nil, nil

                for _, rarity in ipairs(priority) do
                    local candidates = {}
                    for _, egg in ipairs(eggs) do
                        if egg and egg.Parent then
                            if not farmIsMine(egg) and not farmIsPlaced(egg) and not farmIsRecent(egg) then
                                if farmRarity(egg) == rarity then table.insert(candidates, egg) end
                            end
                        end
                    end
                    if #candidates > 0 then
                        chosenRarity = rarity
                        chosenEgg = candidates[1]
                        break
                    end
                end

                if chosenEgg then
                    farmEmpty = 0
                    farmProcess(chosenEgg, chosenRarity)
                    farmProcessed = farmProcessed + 1
                    if farmProcessed % farmConfig.IDLE_RESET_EVERY == 0 then farmIdleReset() end
                    task.wait(0.1)
                else
                    farmEmpty = farmEmpty + 1
                    local backoff = math.min(5, math.max(0.5, 1.5 ^ math.min(farmEmpty, 3)))
                    farmNotifyOnce("Egg Farm", "Waiting for priority egg...")
                    task.wait(backoff)
                end
            end
        end
        task.wait(0.05)
    end
    farmThread = nil
end

