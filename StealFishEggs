local slotAuto = false
local slotInterval = 1

local function slotPrice(level)
    local ok, price = pcall(function()
        return FishConfig.GetSlotUpgradePrice(level)
    end)
    if ok and type(price) == "number" then return price end
    return nil
end

local function slotCanUpgrade()
    local current = tonumber(ActiveFishSlots.Value) or FishConfig.Settings.BaseActiveFishSlots
    local max = FishConfig.Settings.MaxActiveFishSlots
    if current >= max then return false, "MAX" end
    local price = slotPrice(current)
    if not price then return false, "Unknown price" end
    if (tonumber(Cash.Value) or 0) < price then return false, "Not enough cash" end
    return true, price
end

local function slotTry()
    local ok, info = slotCanUpgrade()
    if ok then UpgradeFishSlots:FireServer() end
    return ok, info
end

local claimState = { Unlocked = {}, Claimed = {} }
local claimAuto = false
local claimInterval = 0.5

local function claimPending(fish)
    return claimState.Unlocked[fish] == true and claimState.Claimed[fish] ~= true
end

local function claimCount()
    local n = 0
    for fish in pairs(claimState.Unlocked) do
        if FishIndexConfig.IsValidFish(fish) and claimPending(fish) then
            n += 1
        end
    end
    return n
end

local function claimApply(snap)
    if type(snap) ~= "table" then return end
    claimState.Unlocked = type(snap.Unlocked) == "table" and snap.Unlocked or {}
    claimState.Claimed = type(snap.Claimed) == "table" and snap.Claimed or {}
end

FishIndexUpdated.OnClientEvent:Connect(claimApply)

task.spawn(function()
    local ok, snap = pcall(function() return GetFishIndexState:InvokeServer() end)
    if ok then claimApply(snap) end
end)

local function claimAll()
    if claimCount() > 0 then
        ClaimFishIndex:FireServer("ALL")
    end
end

local hatchAuto = false
local hatchSavedCFrame = nil
local hatchLastPrompt = 0
local hatchBusy = false
local HATCH_PROMPT_COOLDOWN = 0.4
local HATCH_EMPTY_STOP = 3

local function getHRP()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function getPivot(obj)
    if obj:IsA("Model") then return obj:GetPivot().Position end
    if obj:IsA("BasePart") then return obj.Position end
    return nil
end

local function getMyPlacedEggs()
    local list = {}
    for _, egg in ipairs(PlacedEggs:GetChildren()) do
        if egg:IsA("Model") and tonumber(egg:GetAttribute("OwnerUserId")) == LocalPlayer.UserId then
            table.insert(list, egg)
        end
    end
    return list
end

local function hatchReady(egg)
    if egg:GetAttribute("HatchReady") == true then return true end
    local remaining = tonumber(egg:GetAttribute("GrowthRemaining"))
    if remaining ~= nil and remaining <= 0 then return true end
    return false
end

local function findHatchPrompt(egg)
    if not egg then return nil end
    for _, desc in ipairs(egg:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Name == "SkipHatchGrowthPrompt" then
            return desc
        end
    end
    return nil
end

local function teleportTo(pos)
    local hrp = getHRP()
    if not hrp then return end
    hrp.CFrame = CFrame.new(pos)
end

local function faceTowards(targetPos)
    local hrp = getHRP()
    if not hrp then return end
    local look = Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z)
    if (look - hrp.Position).Magnitude > 0.1 then
        hrp.CFrame = CFrame.lookAt(hrp.Position, look)
    end
end

local function pressPrompt(prompt)
    if not prompt then return end
    local hold = tonumber(prompt.HoldDuration) or 0.2
    pcall(function() prompt.Enabled = true end)
    pcall(function() prompt:InputHoldBegin() end)
    task.wait(hold)
    pcall(function() prompt:InputHoldEnd() end)
end

local function hatchProcess(egg)
    if hatchBusy then return end
    if not hatchReady(egg) then return end
    hatchBusy = true

    local pos = getPivot(egg)
    if pos then
        teleportTo(pos + Vector3.new(0, 2, 0))
        faceTowards(pos)
        task.wait(0.15)

        if egg.Parent and hatchReady(egg) then
            local prompt = findHatchPrompt(egg)
            if prompt and prompt.Enabled then
                local now = tick()
                local waitNeeded = HATCH_PROMPT_COOLDOWN - (now - hatchLastPrompt)
                if waitNeeded > 0 then task.wait(waitNeeded) end
                pressPrompt(prompt)
                hatchLastPrompt = tick()
                task.wait(0.25)
            end
        end
    end

    hatchBusy = false
end

local function hatchReturn()
    if hatchSavedCFrame then
        local hrp = getHRP()
        if hrp then hrp.CFrame = hatchSavedCFrame end
    end
end

