local function getUpgradePriceFromGui(upgradeName)
    local upgradeBoard = LocalPlayer.PlayerGui:FindFirstChild("UpgradeBoardGUI")
    if not upgradeBoard then return nil end
    local scrolling = upgradeBoard:FindFirstChild("ScrollingFrame")
    if not scrolling then return nil end
    local card = scrolling:FindFirstChild(upgradeName)
    if not card then return nil end
    local priceLabel = card:FindFirstChild("Price")
    if not priceLabel or not priceLabel:IsA("TextLabel") then return nil end
    return parseMoneyText(priceLabel.Text)
end

local function getOwnedTollBillboards()
    local billboards = {}
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return billboards end
    local plot = findOwnedPlot()
    if not plot then return billboards end
    for _, obj in ipairs(playerGui:GetDescendants()) do
        if obj:IsA("BillboardGui") and obj.Name:lower():find("toll") then
            local adornee = obj.Adornee
            if adornee and adornee:IsDescendantOf(plot) then
                table.insert(billboards, obj)
            end
        end
    end
    return billboards
end

local function getBillboardPrice(billboard)
    for _, label in ipairs(billboard:GetDescendants()) do
        if label:IsA("TextLabel") then
            local name = label.Name:lower()
            if name:find("price") or name:find("cost") then
                local price = parseMoneyText(label.Text)
                if price then return price end
            end
        end
    end
    return nil
end

task.spawn(function()
    while true do
        if autoRebirthEnabled then
            pcall(function()
                local rebirths = LocalPlayer:FindFirstChild("Rebirths")
                if rebirths and (rebirths:IsA("IntValue") or rebirths:IsA("NumberValue")) then
                    local currentRebirths = math.floor(rebirths.Value)
                    local currentLevel = RebirthDefinitions:GetLevel(currentRebirths)
                    local nextLevel = RebirthDefinitions:GetNextLevel(currentRebirths)
                    if nextLevel then
                        local money = getMoney()
                        if money >= currentLevel.RequiredMoney then
                            RebirthEvent:FireServer("Rebirth")
                        end
                    end
                end
            end)
        end
        task.wait(1)
    end
end)

