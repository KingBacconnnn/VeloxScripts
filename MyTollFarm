end

local function getCarRaritySimple(prompt)
    local obj = prompt.Parent
    for _ = 1, 3 do
        if obj then
            local rarity = obj:GetAttribute("Rarity")
            if rarity then return tostring(rarity) end
            obj = obj.Parent
        end
    end
    return nil
end

local function findClaimPromptsByRarity(plot, selected)
    local prompts = {}
    for _, obj in ipairs(plot:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Name == "ClaimPrompt" then
            local rarity = getCarRaritySimple(obj)
            if rarity and selected[rarity] then
                table.insert(prompts, obj)
            end
        end
    end
    return prompts
end

