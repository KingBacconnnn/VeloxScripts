local RENDER_NAME = "CoH_StableController"
RunService:UnbindFromRenderStep(RENDER_NAME)

RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Character.Value + 1, function(dt)
    local now = os.clock()
    local ok, err = xpcall(function()
        runnerStep(now, dt)
    end, function(e)
        return tostring(e)
    end)
    if not ok then
        setDebugError(err)
    end
    local catcherOk, catcherErr = xpcall(function()
        catcherStep(now, dt)
    end, function(e)
        return tostring(e)
    end)
    if not catcherOk then
        setDebugError(catcherErr)
    end
    if now - runtime.utilityTick >= 0.25 then
        runtime.utilityTick = now
        local utilityOk, utilityErr = xpcall(function()
            utilityStep(now)
        end, function(e)
            return tostring(e)
        end)
        if not utilityOk then
            setDebugError(utilityErr)
        end
    end
    if runtime.debugEnabled and now - (runtime.debugPanelAt or -math.huge) >= 0.1 then
        runtime.debugPanelAt = now
        local debugOk, debugErr = xpcall(function()
            updateDebugPanel(now)
        end, function(e)
            return tostring(e)
        end)
        if not debugOk then
            setDebugError("DebugPanel: " .. debugErr)
        end
    end
end)

script.Destroying:Connect(function()
    cancelRevive()
    RunService:UnbindFromRenderStep(RENDER_NAME)
    cleanupVisuals()
    runtime.mapCache = nil
    runtime.mapCacheAt = -math.huge
    runtime.safeCheckAt = -math.huge
    runtime.safeCheckPosition = nil
    edgeRayCache.map = nil
    edgeRayCache.field = nil
    edgeRayCache.params = nil
end)
